@model IEnumerable<DuAnEnglish.Models.LopHoc>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản Lý Lớp Học";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="w-full max-w-5xl bg-white p-8 rounded shadow-md">
        <h2 class="text-2xl font-bold text-red-600 mb-6 text-center">Quản lý lớp học</h2>

        <div class="text-left mb-6">
            <a href="@Url.Action("Them", "QuanLyLopHoc")"
               class="inline-block px-4 py-2 text-sm font-medium rounded bg-green-500 text-white hover:bg-green-600">
                + Thêm mới
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full table-auto border border-gray-300">
                <thead class="bg-red-600 text-white text-center">
                    <tr>
                        <th class="px-4 py-2 border border-white">Mã Lớp</th>
                        <th class="px-4 py-2 border border-white">Tên Lớp</th>
                        <th class="px-4 py-2 border border-white">Slot</th>
                        <th class="px-4 py-2 border border-white">Thứ</th>
                        <th class="px-4 py-2 border border-white">Giờ học</th>
                        <th class="px-4 py-2 border border-white" colspan="2">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lop in Model)
                    {
                        <tr class="hover:bg-gray-100">
                            <td class="px-4 py-2 border text-center">@lop.IDLopHoc</td>
                            <td class="px-4 py-2 border text-center">@lop.TenLop</td>
                            <td class="px-4 py-2 border text-center">@lop.Slot</td>
                            <td class="px-4 py-2 border text-center">@lop.ThuTrongTuan</td>
                            <td class="px-4 py-2 border text-center">
                                @DateTime.Today.Add(lop.GioHocBD.Value).ToString("HH:mm") -
                                @DateTime.Today.Add(lop.GioHocKT.Value).ToString("HH:mm")
                            </td>

                            <td class="px-4 py-2 border text-center">
                                <a href="@Url.Action("Sua", "QuanLyLopHoc", new { id = lop.IDLopHoc })"
                                   class="bg-red-600 hover:bg-red-500 text-white font-semibold py-1 px-3 rounded">
                                    Sửa
                                </a>
                            </td>
                            <td class="px-4 py-2 border text-center">
                                <form method="post" action="@Url.Action("Xoa", "QuanLyLopHoc", new { id = lop.IDLopHoc })" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-1 px-3 rounded shadow">
                                        Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/Scripts/JSThongBao.js"></script>
<script src="~/Scripts/JSXacNhanXoa.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
