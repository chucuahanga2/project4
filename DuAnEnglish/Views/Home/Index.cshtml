@model IEnumerable<DuAnEnglish.Models.KhoaHoc>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang Chủ - Nền Tảng Khóa Học Trực Tuyến Hàng Đầu";
    var dsDanhMuc = ViewBag.DanhSachDanhMuc as List<DuAnEnglish.Models.DanhMucKhoaHoc> ?? new List<DuAnEnglish.Models.DanhMucKhoaHoc>();
    var khList = Model != null ? Model.ToList() : new List<DuAnEnglish.Models.KhoaHoc>();
}

<!-- Top Hero & Promo Banner (Tiki Style) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
    <!-- Big Main Promo Banner (2 cols) -->
    <div class="lg:col-span-2 relative bg-gradient-to-r from-[#0b74e5] via-[#1a94ff] to-blue-500 rounded-xl overflow-hidden p-6 sm:p-10 text-white shadow-sm flex flex-col justify-between min-h-[260px]">
        <div class="relative z-10 max-w-xl">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-yellow-300 text-xs font-bold uppercase tracking-wider mb-4 border border-white/20">
                <i class="fas fa-bolt text-yellow-300"></i> ƯU ĐÃI KHÓA HỌC HÈ 2026
            </div>
            <h1 class="text-2xl sm:text-4xl font-black leading-tight mb-3 tracking-tight">
                Làm Chủ Lập Trình &amp; Ngoại Ngữ Thực Chiến Cùng <span class="text-yellow-300">TikiCourse</span>
            </h1>
            <p class="text-xs sm:text-sm text-blue-100 mb-6 leading-relaxed">
                Hơn 50+ khóa học thực chiến từ chuyên gia ThS. Huỳnh Phước. Đầy đủ video HD, giáo trình, bài tập và mã nguồn mẫu.
            </p>
            <div class="flex flex-wrap items-center gap-3">
                <a href="@Url.Action("KhoaHoc", "KhoaHoc")" 
                   class="bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-lg shadow transition flex items-center gap-2">
                    <i class="fas fa-compass"></i> Khám phá khóa học
                </a>
                <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { priceFilter = "free" })" 
                   class="bg-white/20 hover:bg-white/30 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-lg transition border border-white/30">
                    Khóa học miễn phí 0đ
                </a>
            </div>
        </div>
        <div class="absolute -right-10 -bottom-10 opacity-20 pointer-events-none hidden sm:block">
            <i class="fas fa-laptop-code text-[200px]"></i>
        </div>
    </div>

    <!-- Side Promo Cards (1 col) -->
    <div class="flex flex-col gap-4">
        <!-- Promo 1 -->
        <div class="bg-white rounded-xl p-5 border border-[#ebebf0] shadow-sm flex items-center justify-between gap-4">
            <div>
                <span class="inline-block px-2 py-0.5 rounded bg-red-100 text-[#ff424e] font-bold text-[11px] mb-1">
                    HOT NHẤT
                </span>
                <h3 class="font-bold text-sm text-[#27272a] line-clamp-1">ASP.NET MVC 5 &amp; EF 6</h3>
                <p class="text-xs text-[#808089] mt-0.5">Khóa học miễn phí dành cho sinh viên</p>
                <div class="mt-2 text-[#ff424e] font-black text-sm">0 ₫ <span class="text-xs text-[#808089] font-normal line-through ml-1">1.200.000 ₫</span></div>
            </div>
            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = "MVC2026" })" class="w-10 h-10 rounded-full bg-blue-50 text-[#1a94ff] flex items-center justify-center hover:bg-[#1a94ff] hover:text-white transition flex-shrink-0">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <!-- Promo 2 -->
        <div class="bg-white rounded-xl p-5 border border-[#ebebf0] shadow-sm flex items-center justify-between gap-4">
            <div>
                <span class="inline-block px-2 py-0.5 rounded bg-green-100 text-[#00ab56] font-bold text-[11px] mb-1">
                    CHỨNG CHỈ
                </span>
                <h3 class="font-bold text-sm text-[#27272a] line-clamp-1">Luyện Thi TOEIC 750+</h3>
                <p class="text-xs text-[#808089] mt-0.5">Mẹo giải đề và bứt phá điểm số</p>
                <div class="mt-2 text-[#ff424e] font-black text-sm">650.000 ₫ <span class="text-xs text-[#808089] font-normal line-through ml-1">1.500.000 ₫</span></div>
            </div>
            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = "TIB2025" })" class="w-10 h-10 rounded-full bg-green-50 text-[#00ab56] flex items-center justify-center hover:bg-[#00ab56] hover:text-white transition flex-shrink-0">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Tiki Categories Carousel / Pills Bar -->
<div class="bg-white rounded-xl p-4 border border-[#ebebf0] shadow-sm mb-6">
    <div class="text-xs font-bold text-[#808089] uppercase tracking-wider mb-3">
        Danh Mục Khám Phá Nhanh
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { category = "Lập trình Web" })" 
           class="flex items-center gap-3 p-3 rounded-lg border border-[#ebebf0] hover:border-[#1a94ff] hover:bg-[#f0f8ff] transition group">
            <div class="w-10 h-10 rounded-lg bg-blue-100 text-[#1a94ff] flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 transition">
                <i class="fas fa-code"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-[#27272a] group-hover:text-[#1a94ff]">Lập trình Web</div>
                <div class="text-[11px] text-[#808089]">ASP.NET, MVC</div>
            </div>
        </a>

        <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { category = "Lập trình C# / .NET" })" 
           class="flex items-center gap-3 p-3 rounded-lg border border-[#ebebf0] hover:border-[#1a94ff] hover:bg-[#f0f8ff] transition group">
            <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 transition">
                <i class="fas fa-laptop-code"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-[#27272a] group-hover:text-[#1a94ff]">C# / .NET</div>
                <div class="text-[11px] text-[#808089]">OOP, LINQ, C#</div>
            </div>
        </a>

        <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { category = "Cơ sở dữ liệu & SQL" })" 
           class="flex items-center gap-3 p-3 rounded-lg border border-[#ebebf0] hover:border-[#1a94ff] hover:bg-[#f0f8ff] transition group">
            <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 transition">
                <i class="fas fa-database"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-[#27272a] group-hover:text-[#1a94ff]">SQL Server</div>
                <div class="text-[11px] text-[#808089]">CSDL, Tối ưu</div>
            </div>
        </a>

        <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { category = "Ngoại ngữ & Tiếng Anh" })" 
           class="flex items-center gap-3 p-3 rounded-lg border border-[#ebebf0] hover:border-[#1a94ff] hover:bg-[#f0f8ff] transition group">
            <div class="w-10 h-10 rounded-lg bg-emerald-100 text-[#00ab56] flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 transition">
                <i class="fas fa-language"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-[#27272a] group-hover:text-[#1a94ff]">Ngoại Ngữ</div>
                <div class="text-[11px] text-[#808089]">IELTS, TOEIC</div>
            </div>
        </a>

        <a href="@Url.Action("KhoaHoc", "KhoaHoc", new { priceFilter = "free" })" 
           class="flex items-center gap-3 p-3 rounded-lg border border-[#ebebf0] hover:border-[#ff424e] hover:bg-[#fff0f1] transition group">
            <div class="w-10 h-10 rounded-lg bg-red-100 text-[#ff424e] flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 transition">
                <i class="fas fa-gift"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-[#ff424e]">Khóa Miễn Phí</div>
                <div class="text-[11px] text-[#808089]">Học ngay 0đ</div>
            </div>
        </a>
    </div>
</div>

<!-- Tiki Flash Sale / Giá Tốt Hôm Nay Section -->
<div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm mb-8 overflow-hidden">
    <!-- Header Tiki Deal -->
    <div class="bg-gradient-to-r from-[#ff424e] to-rose-600 px-5 py-3.5 flex items-center justify-between text-white">
        <div class="flex items-center gap-2">
            <span class="text-lg">🔥</span>
            <h2 class="text-base font-extrabold uppercase tracking-wide">GIÁ TỐT MỖI NGÀY &bull; KHÓA HỌC BÁN CHẠY</h2>
        </div>
        <div class="flex items-center gap-2 text-xs">
            <span class="text-rose-100 hidden sm:inline">Kết thúc trong:</span>
            <div class="flex items-center gap-1 font-mono font-bold">
                <span class="bg-white/20 px-2 py-0.5 rounded">02</span> :
                <span class="bg-white/20 px-2 py-0.5 rounded">45</span> :
                <span class="bg-white/20 px-2 py-0.5 rounded">18</span>
            </div>
        </div>
    </div>

    <!-- Deal Cards Grid -->
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var kh in khList.Take(4))
        {
            decimal gia = kh.HocPhi.HasValue ? kh.HocPhi.Value : 0;
            bool isFree = gia == 0;
            decimal giaGoc = isFree ? 990000 : gia * 1.5m;

            <div class="bg-white rounded-lg border border-[#ebebf0] overflow-hidden flex flex-col justify-between tiki-card-hover group">
                <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" class="block relative aspect-video bg-gray-100 overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(kh.HinhAnhKH) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : kh.HinhAnhKH)" 
                         alt="@kh.TenKhoaHoc"
                         class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                         onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80'" />
                    
                    @if (isFree)
                    {
                        <span class="absolute top-2 left-2 bg-[#00ab56] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                            MIỄN PHÍ
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-2 left-2 bg-[#ff424e] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                            -33%
                        </span>
                    }
                </a>

                <div class="p-3.5 flex flex-col flex-grow justify-between">
                    <div>
                        <div class="text-[11px] text-[#808089] mb-1 flex items-center justify-between">
                            <span>@(kh.DanhMuc ?? "Khóa học")</span>
                            <span class="text-emerald-600 font-semibold"><i class="fas fa-check-circle text-[10px]"></i> Chính hãng</span>
                        </div>
                        <h3 class="text-xs font-semibold text-[#27272a] line-clamp-2 group-hover:text-[#1a94ff] transition leading-snug mb-2">
                            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })">
                                @kh.TenKhoaHoc
                            </a>
                        </h3>
                        <!-- Rating Stars (Tiki Yellow) -->
                        <div class="flex items-center gap-1.5 text-[11px] mb-2">
                            <div class="flex text-[#ffc400] text-xs">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <span class="text-[#808089]">(4.8)</span>
                            <span class="text-gray-300">|</span>
                            <span class="text-[#808089]">Đã học 1.2k</span>
                        </div>
                    </div>

                    <!-- Price Block -->
                    <div class="pt-2 border-t border-[#ebebf0]">
                        <div class="flex items-baseline gap-2">
                            @if (isFree)
                            {
                                <span class="text-base font-extrabold text-[#00ab56]">0 ₫</span>
                                <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                            }
                            else
                            {
                                <span class="text-base font-extrabold text-[#ff424e]">@gia.ToString("N0") ₫</span>
                                <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                                <span class="text-[10px] text-[#ff424e] bg-[#fff0f1] px-1 py-0.5 rounded font-bold">-33%</span>
                            }
                        </div>
                        <div class="mt-2.5">
                            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" 
                               class="w-full block text-center py-1.5 rounded-lg bg-[#e5f2ff] hover:bg-[#1a94ff] text-[#0b74e5] hover:text-white font-bold text-xs transition">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Tiki Main Courses Catalog ("Gợi ý hôm nay") -->
<div class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
            <h2 class="text-lg font-extrabold text-[#27272a] uppercase tracking-wide flex items-center gap-2">
                <i class="fas fa-graduation-cap text-[#1a94ff]"></i> TẤT CẢ KHÓA HỌC TRỰC TUYẾN
            </h2>
            <p class="text-xs text-[#808089] mt-0.5">Tuyển chọn các khóa học lập trình, công nghệ và chứng chỉ tiếng Anh chất lượng cao</p>
        </div>
        <a href="@Url.Action("KhoaHoc", "KhoaHoc")" class="text-xs font-bold text-[#1a94ff] hover:text-[#0b74e5] flex items-center gap-1 transition">
            Xem tất cả khóa học <i class="fas fa-chevron-right text-[10px]"></i>
        </a>
    </div>

    <!-- Course Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var kh in khList)
        {
            decimal gia = kh.HocPhi.HasValue ? kh.HocPhi.Value : 0;
            bool isFree = gia == 0;
            decimal giaGoc = isFree ? 990000 : gia * 1.4m;

            <div class="bg-white rounded-lg border border-[#ebebf0] overflow-hidden flex flex-col justify-between tiki-card-hover group">
                <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" class="block relative aspect-video bg-gray-100 overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(kh.HinhAnhKH) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80" : kh.HinhAnhKH)" 
                         alt="@kh.TenKhoaHoc"
                         class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                         onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80'" />
                    
                    @if (isFree)
                    {
                        <span class="absolute top-2 left-2 bg-[#00ab56] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                            MIỄN PHÍ
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-2 left-2 bg-[#1a94ff] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                            TikiPRO
                        </span>
                    }
                </a>

                <div class="p-3.5 flex flex-col flex-grow justify-between">
                    <div>
                        <div class="text-[11px] text-[#808089] mb-1 flex items-center justify-between">
                            <span>@(kh.DanhMuc ?? "Công nghệ")</span>
                            <span class="text-xs text-blue-500"><i class="fas fa-chalkboard-teacher"></i> ThS. Huỳnh Phước</span>
                        </div>
                        <h3 class="text-xs font-semibold text-[#27272a] line-clamp-2 group-hover:text-[#1a94ff] transition leading-snug mb-2">
                            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })">
                                @kh.TenKhoaHoc
                            </a>
                        </h3>
                        <p class="text-[11px] text-[#808089] line-clamp-2 mb-2">
                            @(kh.MoTa ?? "Khóa học trực tuyến chất lượng cao, bài giảng sắc nét và hỗ trợ thực hành tận tâm.")
                        </p>
                        <!-- Rating Stars -->
                        <div class="flex items-center gap-1.5 text-[11px] mb-2">
                            <div class="flex text-[#ffc400] text-xs">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <span class="text-[#808089]">(5.0)</span>
                        </div>
                    </div>

                    <!-- Price Block -->
                    <div class="pt-2 border-t border-[#ebebf0]">
                        <div class="flex items-baseline gap-2">
                            @if (isFree)
                            {
                                <span class="text-base font-extrabold text-[#00ab56]">0 ₫</span>
                                <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                            }
                            else
                            {
                                <span class="text-base font-extrabold text-[#ff424e]">@gia.ToString("N0") ₫</span>
                                <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                            }
                        </div>
                        <div class="mt-2.5">
                            <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" 
                               class="w-full block text-center py-1.5 rounded-lg bg-[#e5f2ff] hover:bg-[#1a94ff] text-[#0b74e5] hover:text-white font-bold text-xs transition">
                                Đăng ký học ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

