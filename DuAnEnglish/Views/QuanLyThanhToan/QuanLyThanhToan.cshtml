@model IEnumerable<DuAnEnglish.Models.ThanhToan>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Thanh toán";
    string currentStatus = ViewBag.CurrentTrangThai as string ?? "all";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800 font-weight-bold">QUẢN LÝ GIAO DỊCH THANH TOÁN</h1>
<p class="mb-4">Theo dõi chi tiết các giao dịch mua khóa học, trạng thái VNPay và phê duyệt kích hoạt tài khoản học tập.</p>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- DataTales Card (SB Admin 2 format) -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-file-invoice-dollar mr-1"></i> Danh Sách Hóa Đơn Thanh Toán (@(Model != null ? Model.Count() : 0))
        </h6>
    </div>

    <div class="card-body">
        <!-- Search and Filter Toolbar -->
        <form method="get" action="@Url.Action("QuanLyThanhToan")" class="mb-3">
            <div class="form-row align-items-center">
                <div class="col-md-5 my-1">
                    <div class="input-group">
                        <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm theo mã HĐ, tên đăng nhập hoặc khóa học...">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 my-1">
                    <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                        <a href="@Url.Action("QuanLyThanhToan", new { trangthai = "all", search = currentSearch })" 
                           class="btn @(currentStatus == "all" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Tất cả</a>
                        <a href="@Url.Action("QuanLyThanhToan", new { trangthai = "Đã thanh toán", search = currentSearch })" 
                           class="btn @(currentStatus == "Đã thanh toán" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Đã thanh toán</a>
                        <a href="@Url.Action("QuanLyThanhToan", new { trangthai = "Chưa thanh toán", search = currentSearch })" 
                           class="btn @(currentStatus == "Chưa thanh toán" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Chưa thanh toán</a>
                    </div>
                </div>
                <div class="col-md-3 my-1 text-right">
                    <a href="@Url.Action("QuanLyThanhToan")" class="btn btn-secondary btn-sm">
                        <i class="fas fa-sync-alt mr-1"></i> Làm mới
                    </a>
                </div>
            </div>
        </form>

        <!-- 5-Column Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 80px;" class="text-center">Mã HĐ</th>
                        <th>Học viên / Tài khoản</th>
                        <th>Khóa học đăng ký</th>
                        <th style="width: 170px;">Số tiền & Ngày tạo</th>
                        <th style="width: 180px;" class="text-center">Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Cột 1: Mã HĐ & Đăng ký -->
                                <td class="text-center font-weight-bold text-primary">
                                    #@item.IDThanhToan
                                    @if (item.IDDangKy.HasValue)
                                    {
                                        <div class="small text-muted">ĐK: #@item.IDDangKy</div>
                                    }
                                </td>

                                <!-- Cột 2: Học viên / Tên đăng nhập -->
                                <td>
                                    <div class="font-weight-bold text-gray-800">
                                        <i class="fas fa-user mr-1 text-muted"></i> @item.TenDangNhap
                                    </div>
                                    <div class="small text-muted">
                                        Phương thức: @(string.IsNullOrEmpty(item.PhuongThucTT) ? "VNPay QR / Thẻ" : item.PhuongThucTT)
                                    </div>
                                </td>

                                <!-- Cột 3: Khóa học đăng ký -->
                                <td>
                                    <div class="font-weight-bold text-primary">
                                        @(item.KhoaHoc != null ? item.KhoaHoc.TenKhoaHoc : item.IDKhoaHoc)
                                    </div>
                                    <div class="small text-muted">
                                        Mã KH: <span class="badge badge-light border">@item.IDKhoaHoc</span>
                                    </div>
                                </td>

                                <!-- Cột 4: Số tiền & Ngày thanh toán -->
                                <td>
                                    <div class="font-weight-bold text-danger">
                                        @string.Format("{0:N0} đ", item.SoTien ?? 0)
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="far fa-calendar-alt mr-1"></i>
                                        @(item.NgayThanhToan.HasValue ? item.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa thanh toán")
                                    </div>
                                    <div class="mt-1">
                                        @if (item.TrangThai == "Đã thanh toán")
                                        {
                                            <span class="badge badge-status-active">
                                                <i class="fas fa-check mr-1"></i> Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status-pending">
                                                <i class="fas fa-clock mr-1"></i> Chưa thanh toán
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Cột 5: Chức năng -->
                                <td class="text-center">
                                    <a href="@Url.Action("ChiTiet", new { id = item.IDThanhToan })" class="btn btn-info btn-sm shadow-sm" title="Xem chi tiết">
                                        <i class="fas fa-eye mr-1"></i> Chi tiết
                                    </a>

                                    @if (item.TrangThai != "Đã thanh toán")
                                    {
                                        using (Html.BeginForm("DuyetThanhToan", "QuanLyThanhToan", new { id = item.IDThanhToan }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm shadow-sm ml-1" 
                                                    onclick="return confirm('Xác nhận kích hoạt và hoàn tất thanh toán hóa đơn #@item.IDThanhToan cho học viên @item.TenDangNhap?');"
                                                    title="Duyệt thanh toán thủ công">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    }

                                    @using (Html.BeginForm("Delete", "QuanLyThanhToan", new { id = item.IDThanhToan }, FormMethod.Post, new { @class = "d-inline ml-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm" 
                                                onclick="return confirm('Bạn có chắc muốn xóa hóa đơn #@item.IDThanhToan?');"
                                                title="Xóa hóa đơn">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-file-invoice fa-2x mb-2 text-gray-400 d-block"></i>
                                Không tìm thấy hóa đơn thanh toán nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>