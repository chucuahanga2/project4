@{
    ViewBag.Title = "Trợ Lý Tư Vấn Khóa Học - TikiCourse";
    Layout = null;
    var chatHistory = ViewBag.ChatHistory as List<DuAnEnglish.Controllers.ChatHistoryItem>;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #eef2ff 0%, #f5f5fa 100%);
        }
        .chat-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .chat-scroll::-webkit-scrollbar-thumb {
            background-color: #d1d5db;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-3 sm:p-6">

    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden flex flex-col h-[700px] max-h-[92vh]">
        <!-- Chat Header -->
        <div class="bg-gradient-to-r from-[#0b74e5] to-[#1a94ff] p-4 text-white flex items-center justify-between shadow-md">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <div class="w-11 h-11 rounded-full bg-white text-[#1a94ff] flex items-center justify-center font-bold text-lg shadow-sm">
                        <i class="fas fa-robot text-xl"></i>
                    </div>
                    <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-400 border-2 border-white rounded-full"></span>
                </div>
                <div>
                    <h1 class="text-base font-bold leading-tight flex items-center gap-1.5">
                        TikiCourse AI Bot
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/20 font-medium">Trực tuyến</span>
                    </h1>
                    <p class="text-xs text-blue-100">Tư vấn khóa học, học phí &amp; hỗ trợ 24/7</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a href="@Url.Action("Index", "Home")" class="px-3 py-1.5 bg-white/15 hover:bg-white/25 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 text-white" title="Trở về Trang chủ">
                    <i class="fas fa-arrow-left"></i>
                    <span class="hidden sm:inline">Trang chủ</span>
                </a>
            </div>
        </div>

        <!-- Chat Messages Area -->
        <div id="chatWindow" class="flex-grow overflow-y-auto p-4 sm:p-6 space-y-4 chat-scroll bg-[#fafafa]">
            <!-- Welcome Bot Message -->
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-[#1a94ff] text-white flex items-center justify-center flex-shrink-0 text-xs shadow-sm">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="max-w-[80%] bg-white border border-gray-200 text-gray-800 p-3.5 rounded-2xl rounded-tl-sm shadow-sm text-sm leading-relaxed">
                    <p class="font-semibold text-[#0b74e5] mb-1">Xin chào bạn! 👋</p>
                    <p>Mình là trợ lý ảo của <strong>TikiCourse</strong>. Mình có thể giải đáp thông tin về các khóa học Lập trình Web ASP.NET MVC, C#, SQL Server, học phí, hình thức học thử và cách thức thanh toán VNPay. Bạn cần mình tư vấn điều gì?</p>
                </div>
            </div>

            @* Lịch sử chat trước đó *@
            @if (chatHistory != null && chatHistory.Any())
            {
                foreach (var item in chatHistory)
                {
                    <!-- Tin nhắn người dùng -->
                    <div class="flex items-start justify-end gap-3">
                        <div class="max-w-[80%] bg-[#1a94ff] text-white p-3.5 rounded-2xl rounded-tr-sm shadow-sm text-sm leading-relaxed text-left">
                            @item.CauHoi
                        </div>
                        <div class="w-8 h-8 rounded-full bg-blue-100 text-[#0b74e5] flex items-center justify-center flex-shrink-0 text-xs font-bold shadow-sm">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>

                    <!-- Phản hồi từ Bot -->
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-[#1a94ff] text-white flex items-center justify-center flex-shrink-0 text-xs shadow-sm">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="max-w-[80%] bg-white border border-gray-200 text-gray-800 p-3.5 rounded-2xl rounded-tl-sm shadow-sm text-sm leading-relaxed">
                            @Html.Raw(item.TraLoi)
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Quick Suggestion Chips -->
        <div class="px-4 py-2 bg-gray-50 border-t border-gray-100 flex items-center gap-2 overflow-x-auto text-xs whitespace-nowrap">
            <span class="text-gray-400 font-medium flex items-center gap-1"><i class="fas fa-lightbulb text-yellow-500"></i> Gợi ý:</span>
            <button type="button" class="quick-chip px-3 py-1 bg-white border border-gray-200 hover:border-[#1a94ff] hover:text-[#1a94ff] rounded-full text-gray-600 transition shadow-2xs font-medium" data-query="Khóa học ASP.NET MVC 5 có gì?">
                ASP.NET MVC 5
            </button>
            <button type="button" class="quick-chip px-3 py-1 bg-white border border-gray-200 hover:border-[#1a94ff] hover:text-[#1a94ff] rounded-full text-gray-600 transition shadow-2xs font-medium" data-query="Làm sao để học thử miễn phí?">
                Học thử miễn phí?
            </button>
            <button type="button" class="quick-chip px-3 py-1 bg-white border border-gray-200 hover:border-[#1a94ff] hover:text-[#1a94ff] rounded-full text-gray-600 transition shadow-2xs font-medium" data-query="Hình thức thanh toán qua VNPay như thế nào?">
                Thanh toán VNPay
            </button>
            <button type="button" class="quick-chip px-3 py-1 bg-white border border-gray-200 hover:border-[#1a94ff] hover:text-[#1a94ff] rounded-full text-gray-600 transition shadow-2xs font-medium" data-query="Học phí các khóa học ra sao?">
                Học phí
            </button>
        </div>

        <!-- Input Area Form -->
        <div class="p-4 bg-white border-t border-gray-200">
            @using (Html.BeginForm("TuVan", "TuVan", FormMethod.Post, new { id = "chatForm", @class = "flex items-end gap-2" }))
            {
                @Html.AntiForgeryToken()
                <div class="flex-grow relative">
                    <textarea name="cauHoi" id="cauHoiInput"
                              class="w-full resize-none rounded-xl px-4 py-2.5 text-sm border border-gray-300 focus:outline-none focus:border-[#1a94ff] focus:ring-1 focus:ring-[#1a94ff] transition leading-normal"
                              rows="2"
                              required
                              placeholder="Nhập câu hỏi của bạn tại đây... (Nhấn Enter để gửi)"></textarea>
                </div>
                <button type="submit" id="sendBtn"
                        class="h-11 w-11 bg-[#1a94ff] hover:bg-[#0b74e5] text-white rounded-xl flex items-center justify-center transition shadow-md flex-shrink-0 group"
                        title="Gửi câu hỏi">
                    <i class="fas fa-paper-plane group-hover:translate-x-0.5 transition"></i>
                </button>
            }
        </div>
    </div>

    <!-- Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chatWindow = document.getElementById('chatWindow');
            const textarea = document.getElementById('cauHoiInput');
            const form = document.getElementById('chatForm');
            const chips = document.querySelectorAll('.quick-chip');

            // Tự động cuộn xuống cuối khung chat
            function scrollToBottom() {
                if (chatWindow) {
                    chatWindow.scrollTop = chatWindow.scrollHeight;
                }
            }
            scrollToBottom();

            // Nhấn Enter để gửi form (Shift + Enter để xuống dòng)
            if (textarea && form) {
                textarea.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        if (textarea.value.trim().length > 0) {
                            form.submit();
                        }
                    }
                });
            }

            // Gợi ý câu hỏi khi bấm vào Chips
            chips.forEach(chip => {
                chip.addEventListener('click', function () {
                    const query = this.getAttribute('data-query');
                    if (query && textarea) {
                        textarea.value = query;
                        textarea.focus();
                    }
                });
            });
        });
    </script>
</body>
</html>
