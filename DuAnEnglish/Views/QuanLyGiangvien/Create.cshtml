@{
    if (Session["Role"] != null)
    {
        var role = Session["Role"].ToString().ToLower();
        if (role == "admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        }
        else if (role == "giangvien")
        {
            Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
        }
    }
}

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white shadow-lg rounded-xl w-full max-w-md p-8">
        
        <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Thêm giảng viên</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="TenGV" class="block text-sm font-medium text-gray-700 mb-1">Tên giảng viên</label>
                <input type="text" id="TenGV" name="TenGV" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label for="NgaySinh" class="block text-sm font-medium text-gray-700 mb-1">Ngày sinh</label>
                <input type="date" id="NgaySinh" name="NgaySinh" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label for="GioiTinh" class="block text-sm font-medium text-gray-700 mb-1">Giới tính</label>
                @Html.DropDownList("GioiTinh", new SelectList(new List<string> { "Nam", "Nữ", "Khác" }), "-- Chọn giới tính --",
                    new { @class = "w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" })
            </div>

            <div class="mb-4">
                <label for="DiaChi" class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ</label>
                <input type="text" id="DiaChi" name="DiaChi" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label for="ChuyenMon" class="block text-sm font-medium text-gray-700 mb-1">Chuyên môn</label>
                <input type="text" id="ChuyenMon" name="ChuyenMon" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label for="BangCap" class="block text-sm font-medium text-gray-700 mb-1">Bằng cấp</label>
                <input type="text" id="BangCap" name="BangCap" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200">
                Thêm giảng viên
            </button>
        }
    </div>
</div>
