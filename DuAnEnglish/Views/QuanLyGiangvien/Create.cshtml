@model DuAnEnglish.Models.GiangVien
@{
    ViewBag.Title = "Thêm Giảng Viên Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">THÊM GIẢNG VIÊN MỚI</h1>
    <a href="@Url.Action("QuanLyGiangVien")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
    </a>
</div>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-9 mx-auto">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-plus mr-1"></i> Thông Tin Giảng Viên Mới</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "QuanLyGiangVien", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <h6 class="heading-small text-muted mb-3 font-weight-bold">1. Thông tin đăng nhập</h6>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Tên Đăng Nhập <span class="text-danger">*</span></label>
                            <input type="text" name="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập giảng viên..." required />
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Mật Khẩu Khởi Tạo <span class="text-danger">*</span></label>
                            <input type="password" name="MatKhau" class="form-control" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>

                    <h6 class="heading-small text-muted mb-3 font-weight-bold mt-3">2. Hồ sơ cá nhân & Chuyên môn</h6>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Họ và Tên Giảng Viên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenGV, new { @class = "form-control", placeholder = "Ví dụ: TS. Nguyễn Văn A...", required = "required" })
                        </div>
                        <div class="form-group col-md-3">
                            <label class="font-weight-bold text-gray-700">Giới Tính</label>
                            <select name="GioiTinh" class="form-control">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label class="font-weight-bold text-gray-700">Ngày Sinh</label>
                            @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="giangvien@example.com" />
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Số Điện Thoại</label>
                            <input type="text" name="SDT" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Chuyên Môn</label>
                            @Html.TextBoxFor(m => m.ChuyenMon, new { @class = "form-control", placeholder = "Ví dụ: ASP.NET Core, Lập trình C#, Cơ sở dữ liệu..." })
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Bằng Cấp / Chứng Chỉ</label>
                            @Html.TextBoxFor(m => m.BangCap, new { @class = "form-control", placeholder = "Ví dụ: Thạc sĩ CNTT, Microsoft Certified..." })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Địa Chỉ</label>
                        @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ..." })
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("QuanLyGiangVien")" class="btn btn-secondary mr-2">
                            <i class="fas fa-times mr-1"></i> Hủy
                        </a>
                        <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                            <i class="fas fa-save mr-1"></i> Lưu Giảng Viên
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
