@model DuAnEnglish.Models.GiangVien
@{
    ViewBag.Title = "Chỉnh sửa Giảng viên: " + Model.TenGV;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string email = Model.TaiKhoan != null ? Model.TaiKhoan.Email : "";
    string sdt = Model.TaiKhoan != null ? Model.TaiKhoan.SDT : "";
    string tt = Model.TaiKhoan != null ? Model.TaiKhoan.TrangThai : "Hoạt động";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">CHỈNH SỬA GIẢNG VIÊN: @Model.TenGV</h1>
    <a href="@Url.Action("QuanLyGiangVien")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
    </a>
</div>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-9 mx-auto">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-edit mr-1"></i> Thông Tin Giảng Viên #@Model.IDGiangVien</h6>
                <span class="badge badge-light border">Tài khoản: @Model.IDTenDangNhap</span>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Details", "QuanLyGiangVien", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.IDGiangVien)
                    @Html.HiddenFor(m => m.IDTenDangNhap)

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Họ và Tên Giảng Viên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenGV, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="form-group col-md-3">
                            <label class="font-weight-bold text-gray-700">Giới Tính</label>
                            <select name="GioiTinh" class="form-control">
                                <option value="Nam" @(Model.GioiTinh == "Nam" ? "selected" : "")>Nam</option>
                                <option value="Nữ" @(Model.GioiTinh == "Nữ" ? "selected" : "")>Nữ</option>
                                <option value="Khác" @(Model.GioiTinh == "Khác" ? "selected" : "")>Khác</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label class="font-weight-bold text-gray-700">Ngày Sinh</label>
                            @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Email</label>
                            <input type="email" name="Email" value="@email" class="form-control" />
                        </div>
                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Số Điện Thoại</label>
                            <input type="text" name="SDT" value="@sdt" class="form-control" />
                        </div>
                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Trạng Thái Tài Khoản</label>
                            <select name="TrangThai" class="form-control">
                                <option value="Hoạt động" @(tt == "Hoạt động" ? "selected" : "")>Hoạt động</option>
                                <option value="Khóa" @(tt == "Khóa" ? "selected" : "")>Khóa</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Chuyên Môn</label>
                            @Html.TextBoxFor(m => m.ChuyenMon, new { @class = "form-control" })
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Bằng Cấp</label>
                            @Html.TextBoxFor(m => m.BangCap, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Địa Chỉ</label>
                        @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="submit" form="formDeleteGV"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Bạn có chắc muốn xóa hoặc khóa giảng viên này?');">
                            <i class="fas fa-trash-alt mr-1"></i> Xóa Giảng Viên
                        </button>
                        <div>
                            <a href="@Url.Action("QuanLyGiangVien")" class="btn btn-secondary mr-2">
                                <i class="fas fa-times mr-1"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-1"></i> Lưu Cập Nhật
                            </button>
                        </div>
                    </div>
                }
                @using (Html.BeginForm("Delete", "QuanLyGiangVien", new { id = Model.IDGiangVien }, FormMethod.Post, new { id = "formDeleteGV", style = "display:none;" }))
                {
                    @Html.AntiForgeryToken()
                }
            </div>
        </div>
    </div>
</div>