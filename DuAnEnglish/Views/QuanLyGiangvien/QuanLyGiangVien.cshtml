@model IEnumerable<DuAnEnglish.Models.GiangVien>
@{
    ViewBag.Title = "Quản lý Giảng viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<h1 class="h3 mb-2 text-gray-800 font-weight-bold">QUẢN LÝ GIẢNG VIÊN</h1>
<p class="mb-4">Quản lý đội ngũ giảng viên, chuyên môn giảng dạy, khóa học phụ trách và tài khoản hệ thống.</p>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-chalkboard-teacher mr-1"></i> Danh Sách Giảng Viên (@(Model != null ? Model.Count() : 0))
        </h6>
        <div class="mt-2 mt-md-0">
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm font-weight-bold">
                <i class="fas fa-plus fa-sm mr-1"></i> Thêm Giảng Viên Mới
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Search form -->
        <form method="get" action="@Url.Action("QuanLyGiangVien")" class="mb-3">
            <div class="form-row align-items-center">
                <div class="col-md-5 my-1">
                    <div class="input-group">
                        <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm theo tên giảng viên, chuyên môn, email...">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 my-1">
                    <a href="@Url.Action("QuanLyGiangVien")" class="btn btn-secondary btn-block">
                        <i class="fas fa-sync-alt mr-1"></i> Làm mới
                    </a>
                </div>
            </div>
        </form>

        <!-- 5-Column Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 70px;" class="text-center">STT</th>
                        <th>Giảng Viên</th>
                        <th>Chuyên Môn & Trình Độ</th>
                        <th style="width: 170px;" class="text-center">Khóa Học & Trạng Thái</th>
                        <th style="width: 160px;" class="text-center">Chức Năng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            string tt = item.TaiKhoan != null ? item.TaiKhoan.TrangThai : "Hoạt động";
                            <tr>
                                <td class="text-center font-weight-bold text-muted">
                                    @stt
                                    <div class="small badge badge-light border">#@item.IDGiangVien</div>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-primary">
                                        <i class="fas fa-user-tie text-gray-400 mr-1"></i>
                                        @(string.IsNullOrEmpty(item.TenGV) ? item.IDTenDangNhap : item.TenGV)
                                    </div>
                                    <div class="small text-muted">
                                        Username: <strong>@item.IDTenDangNhap</strong> | Email: @(item.TaiKhoan != null ? item.TaiKhoan.Email : "N/A")
                                    </div>
                                </td>
                                <td>
                                    <div><i class="fas fa-award text-warning mr-1"></i> <strong>@(item.ChuyenMon ?? "Chưa cập nhật")</strong></div>
                                    <div class="small text-muted mt-1"><i class="fas fa-graduation-cap text-info mr-1"></i> @(item.BangCap ?? "Chưa cập nhật")</div>
                                </td>
                                <td class="text-center">
                                    <div class="font-weight-bold text-dark mb-1">
                                        @(item.KhoaHocs != null ? item.KhoaHocs.Count : 0) khóa học
                                    </div>
                                    <div>
                                        @if (tt == "Hoạt động")
                                        {
                                            <span class="badge badge-status-active">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status-locked">Đã khóa</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.IDGiangVien })" class="btn btn-info btn-sm shadow-sm" title="Sửa thông tin">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @using (Html.BeginForm("KhoaMoTaiKhoan", "QuanLyGiangVien", new { id = item.IDGiangVien }, FormMethod.Post, new { @class = "d-inline ml-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" 
                                                class="btn @(tt == "Khóa" ? "btn-success" : "btn-warning") btn-sm shadow-sm" 
                                                title="@(tt == "Khóa" ? "Mở khóa tài khoản" : "Khóa tài khoản")"
                                                onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản giảng viên này?');">
                                            <i class="fas @(tt == "Khóa" ? "fa-unlock" : "fa-lock")"></i>
                                        </button>
                                    }
                                    @using (Html.BeginForm("Delete", "QuanLyGiangVien", new { id = item.IDGiangVien }, FormMethod.Post, new { @class = "d-inline ml-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" 
                                                class="btn btn-danger btn-sm shadow-sm" 
                                                title="Xóa giảng viên"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa giảng viên này?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-chalkboard-teacher fa-2x mb-2 text-gray-400 d-block"></i>
                                Không tìm thấy giảng viên nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>