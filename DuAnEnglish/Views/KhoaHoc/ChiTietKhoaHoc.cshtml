@model DuAnEnglish.ViewModels.ChiTietKhoaHocViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var kh = Model.KhoaHoc;
    ViewBag.Title = kh.TenKhoaHoc + " - TikiCourse";
    decimal gia = kh.HocPhi.HasValue ? kh.HocPhi.Value : 0;
    bool isFree = gia == 0;
    decimal giaGoc = isFree ? 990000 : gia * 1.5m;
}

<!-- Breadcrumbs (Tiki Style) -->
<nav class="flex items-center gap-2 text-xs text-[#808089] mb-4">
    <a href="@Url.Action("Index", "Home")" class="hover:text-[#1a94ff] transition">Trang chủ</a>
    <span>&rsaquo;</span>
    <a href="@Url.Action("KhoaHoc", "KhoaHoc")" class="hover:text-[#1a94ff] transition">Khóa học</a>
    <span>&rsaquo;</span>
    <span class="text-[#27272a] font-medium line-clamp-1 max-w-md">@kh.TenKhoaHoc</span>
</nav>

<!-- Main Course Details Card (Tiki PDP Top Showcase) -->
<div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm p-5 md:p-8 mb-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left: Image & Instructor Box (5 cols) -->
        <div class="lg:col-span-5">
            <div class="relative aspect-video rounded-xl overflow-hidden bg-gray-100 border border-[#ebebf0] shadow-sm group">
                <img src="@(string.IsNullOrEmpty(kh.HinhAnhKH) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&auto=format&fit=crop&q=80" : kh.HinhAnhKH)" 
                     alt="@kh.TenKhoaHoc" 
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                     onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&auto=format&fit=crop&q=80'" />
                
                @if (isFree)
                {
                    <span class="absolute top-3 left-3 bg-[#00ab56] text-white text-xs font-bold px-2.5 py-1 rounded shadow-sm">
                        MIỄN PHÍ
                    </span>
                }
                else
                {
                    <span class="absolute top-3 left-3 bg-[#1a94ff] text-white text-xs font-bold px-2.5 py-1 rounded shadow-sm">
                        TikiPRO
                    </span>
                }
            </div>

            <!-- Instructor Card (Tiki Shop/Author card) -->
            <div class="mt-4 p-4 rounded-xl border border-[#ebebf0] bg-[#fafafa] flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-[#1a94ff] text-white flex items-center justify-center font-bold text-lg">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <div>
                        <div class="text-[11px] text-[#808089]">Giảng viên giảng dạy</div>
                        <div class="font-bold text-sm text-[#27272a] flex items-center gap-1">
                            ThS. Huỳnh Phước
                            <i class="fas fa-check-circle text-[#1a94ff] text-xs" title="Đã xác minh chính thức"></i>
                        </div>
                        <div class="text-[11px] text-[#808089]">8+ năm kinh nghiệm &bull; ThS. KHMT</div>
                    </div>
                </div>
            </div>

            <!-- Tiki Trust Badges -->
            <div class="mt-4 grid grid-cols-2 gap-2 text-[11px] text-[#808089]">
                <div class="flex items-center gap-2 p-2 bg-[#f5f5fa] rounded-lg">
                    <i class="fas fa-shield-alt text-[#00ab56] text-sm"></i>
                    <span>Bản quyền 100%</span>
                </div>
                <div class="flex items-center gap-2 p-2 bg-[#f5f5fa] rounded-lg">
                    <i class="fas fa-infinity text-[#1a94ff] text-sm"></i>
                    <span>Sở hữu trọn đời</span>
                </div>
                <div class="flex items-center gap-2 p-2 bg-[#f5f5fa] rounded-lg">
                    <i class="fas fa-bolt text-yellow-500 text-sm"></i>
                    <span>Kích hoạt ngay</span>
                </div>
                <div class="flex items-center gap-2 p-2 bg-[#f5f5fa] rounded-lg">
                    <i class="fas fa-headset text-rose-500 text-sm"></i>
                    <span>Hỗ trợ 24/7</span>
                </div>
            </div>
        </div>

        <!-- Right: Course Information & Action (7 cols) -->
        <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
                <!-- Category Tag -->
                <div class="inline-block px-2.5 py-1 rounded bg-[#e5f2ff] text-[#0b74e5] text-xs font-bold uppercase mb-2">
                    @(kh.DanhMuc ?? "Khóa học")
                </div>

                <h1 class="text-xl sm:text-2xl font-black text-[#27272a] leading-tight mb-2">
                    @kh.TenKhoaHoc
                </h1>

                <!-- Rating & Enrolled Count -->
                <div class="flex items-center gap-2 text-xs mb-4">
                    <div class="flex text-[#ffc400]">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <span class="font-bold text-[#ffaa00]">5.0</span>
                    <span class="text-[#808089]">(68 đánh giá)</span>
                    <span class="text-gray-300">|</span>
                    <span class="text-[#808089]">Đã đăng ký: <strong>1,420</strong> học viên</span>
                </div>

                <!-- Tiki Price Highlight Box -->
                <div class="bg-[#fafafa] border border-[#ebebf0] rounded-xl p-4 mb-5">
                    <div class="text-[11px] text-[#808089] uppercase font-bold mb-1">Mức học phí niêm yết:</div>
                    <div class="flex items-baseline gap-3">
                        @if (isFree)
                        {
                            <span class="text-3xl font-black text-[#00ab56]">0 ₫</span>
                            <span class="text-sm text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                            <span class="text-xs text-[#00ab56] bg-green-50 px-2 py-0.5 rounded font-bold">100% MIỄN PHÍ</span>
                        }
                        else
                        {
                            <span class="text-3xl font-black text-[#ff424e]">@gia.ToString("N0") ₫</span>
                            <span class="text-sm text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                            <span class="text-xs text-[#ff424e] bg-[#fff0f1] px-2 py-0.5 rounded font-bold">-33%</span>
                        }
                    </div>
                    @if (!isFree)
                    {
                        <div class="mt-2.5 pt-2.5 border-t border-[#ebebf0] text-xs text-[#808089] flex items-center gap-1.5">
                            <i class="fas fa-qrcode text-[#0b74e5]"></i>
                            <span>Hỗ trợ thanh toán nhanh quét mã <strong>VNPAY-QR</strong> hoặc thẻ ngân hàng nội địa.</span>
                        </div>
                    }
                </div>

                <!-- Course Description Snippet -->
                <p class="text-xs text-[#808089] leading-relaxed mb-6">
                    @(kh.MoTa ?? "Khóa học trực tuyến chất lượng cao, bài giảng sắc nét và hỗ trợ thực hành tận tâm.")
                </p>

                <!-- Course Feature Highlights -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
                    <div class="p-2.5 bg-[#f5f5fa] rounded-lg">
                        <div class="text-[10px] text-[#808089]">Chương trình</div>
                        <div class="font-bold text-xs text-[#27272a]">@Model.DanhSachChuong.Count chương học</div>
                    </div>
                    <div class="p-2.5 bg-[#f5f5fa] rounded-lg">
                        <div class="text-[10px] text-[#808089]">Bài giảng</div>
                        <div class="font-bold text-xs text-[#27272a]">@Model.TongSoBai bài học video</div>
                    </div>
                    <div class="p-2.5 bg-[#f5f5fa] rounded-lg">
                        <div class="text-[10px] text-[#808089]">Thời lượng</div>
                        <div class="font-bold text-xs text-[#27272a]">@Model.TongThoiLuong phút</div>
                    </div>
                </div>
            </div>

            <!-- Action Area -->
            <div>
                @if (Model.DaKichHoat)
                {
                    <div class="space-y-3">
                        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between">
                            <div class="flex items-center gap-2 text-emerald-800 text-xs font-semibold">
                                <i class="fas fa-check-circle text-base text-emerald-600"></i>
                                <span>Bạn đã sở hữu khóa học này! Tiến độ: <strong>@Model.PhanTramTienDo%</strong></span>
                            </div>
                        </div>
                        <a href="@Url.Action("VaoHoc", "HocTap", new { id = kh.IDKhoaHoc })" 
                           class="w-full py-3.5 bg-[#00ab56] hover:bg-emerald-600 text-white font-bold text-sm rounded-xl text-center shadow transition flex items-center justify-center gap-2">
                            <i class="fas fa-play"></i> VÀO HỌC NGAY
                        </a>
                    </div>
                }
                else
                {
                    <form method="post" action="@Url.Action("DangKyKhoaHoc", "KhoaHoc")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@kh.IDKhoaHoc" />

                        @if (isFree)
                        {
                            <button type="submit" 
                                    class="w-full py-3.5 bg-[#00ab56] hover:bg-emerald-600 text-white font-black text-sm rounded-xl shadow transition flex items-center justify-center gap-2">
                                <i class="fas fa-user-plus"></i> ĐĂNG KÝ HỌC MIỄN PHÍ NGAY (0 ₫)
                            </button>
                        }
                        else
                        {
                            <button type="submit" 
                                    class="w-full py-3.5 bg-[#ff424e] hover:bg-red-600 text-white font-black text-sm rounded-xl shadow transition flex items-center justify-center gap-2">
                                <i class="fas fa-bolt"></i> MUA NGAY &bull; THANH TOÁN QUA VNPAY (@gia.ToString("N0") ₫)
                            </button>
                        }
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- Bottom Section: Curriculum & Details Tabs (Tiki Standard) -->
<div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm p-6 mb-8">
    <div class="flex items-center justify-between pb-4 border-b border-[#ebebf0] mb-6">
        <div>
            <h2 class="text-base font-extrabold text-[#27272a] uppercase">Giáo Trình Khóa Học</h2>
            <p class="text-xs text-[#808089] mt-0.5">@Model.DanhSachChuong.Count chương &bull; @Model.TongSoBai bài giảng video &amp; tài liệu</p>
        </div>
    </div>

    @if (Model.DanhSachChuong.Any())
    {
        <div class="space-y-3">
            @{ int idxCh = 1; }
            @foreach (var ch in Model.DanhSachChuong)
            {
                <div class="border border-[#ebebf0] rounded-xl overflow-hidden">
                    <div class="bg-[#fafafa] px-4 py-3 flex items-center justify-between font-bold text-xs text-[#27272a]">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-[#e5f2ff] text-[#0b74e5] flex items-center justify-center text-xs">
                                @idxCh
                            </span>
                            <span>@ch.Chuong.TenChuong</span>
                        </div>
                        <span class="text-[11px] text-[#808089] font-normal">@ch.DanhSachBaiHoc.Count bài học</span>
                    </div>

                    <div class="divide-y divide-[#ebebf0]">
                        @foreach (var bi in ch.DanhSachBai)
                        {
                            var bh = bi.Bai;
                            <div class="px-4 py-3 flex items-center justify-between hover:bg-blue-50/40 transition">
                                <div class="flex items-center gap-3">
                                    <div class="text-gray-400 text-xs">
                                        <i class="far fa-play-circle text-base"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs font-semibold text-[#27272a]">@bh.TenBaiHoc</div>
                                        <div class="text-[11px] text-[#808089]">Thời lượng: @(bh.ThoiLuong ?? 15) phút</div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2">
                                    @if (bh.ChoXemThu == true)
                                    {
                                        <a href="@Url.Action("VaoHoc", "HocTap", new { id = kh.IDKhoaHoc, baiId = bh.IDBaiHoc })" 
                                           class="px-2.5 py-1 rounded bg-[#e5f2ff] hover:bg-[#1a94ff] text-[#0b74e5] hover:text-white text-[11px] font-bold transition flex items-center gap-1">
                                            <i class="fas fa-play text-[9px]"></i> Học thử
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                idxCh++;
            }
        </div>
    }
    else
    {
        <p class="text-xs text-[#808089] italic">Nội dung giáo trình đang được cập nhật bởi giảng viên.</p>
    }
</div>