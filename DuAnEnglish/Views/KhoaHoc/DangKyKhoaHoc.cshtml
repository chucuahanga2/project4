@model DuAnEnglish.Models.ThanhToan

@{
    Layout = "~/Views/Shared/_LayoutHocVien.cshtml";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
    <div class="w-full max-w-2xl bg-white p-8 rounded-2xl shadow-lg border border-gray-200">
        <h2 class="text-2xl font-bold text-center text-red-600 mb-6">Thông tin đăng ký lớp học</h2>

        @using (Html.BeginForm("DangKyKhoaHoc", "KhoaHoc", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="overflow-x-auto">
                <table class="table-auto w-full text-left text-gray-700 border-separate border-spacing-y-2">
                    <tbody>
                        <tr>
                            <td class="font-medium w-1/3">ID Lớp:</td>
                            <td>@Model.IDLopHoc</td>
                            @Html.HiddenFor(m => m.IDLopHoc)
                        </tr>
                        <tr>
                            <td class="font-medium">ID Khóa học:</td>
                            <td>@Model.IDKhoaHoc</td>
                            @Html.HiddenFor(m => m.IDKhoaHoc)
                        </tr>
                        <tr>
                            <td class="font-medium">Tên lớp:</td>
                            <td>@Model.LopHoc.TenLop</td>
                        </tr>
                        <tr>
                            <td class="font-medium">Lịch học:</td>
                            <td>@Model.LopHoc.ThuTrongTuan</td>
                        </tr>
                        <tr>
                            <td class="font-medium">Giờ học:</td>
                            <td>
                                @(Model.LopHoc.GioHocBD.HasValue ? Model.LopHoc.GioHocBD.Value.ToString(@"hh\:mm") : "N/A")
                                -
                                @(Model.LopHoc.GioHocKT.HasValue ? Model.LopHoc.GioHocKT.Value.ToString(@"hh\:mm") : "N/A")
                            </td>
                        </tr>
                        <tr>
                            <td class="font-medium">Giá:</td>
                            <td class="text-green-600 font-semibold">
                                @String.Format("{0:N0} VNĐ", Model.KhoaHoc.HocPhi ?? 0m)
                            </td>
                        </tr>
                        <tr>
                            <td class="font-medium">Tên học viên:</td>
                            <td>@ViewBag.TenHocVien</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded-full transition duration-300">
                                    Đăng ký
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
