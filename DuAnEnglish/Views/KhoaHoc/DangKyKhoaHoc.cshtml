@model DuAnEnglish.Models.KhoaHoc
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Xác nhận đăng ký: " + Model.TenKhoaHoc + " - TikiCourse";
    decimal gia = Model.HocPhi ?? 0;
    bool isFree = gia <= 0;
}

<div class="max-w-xl mx-auto py-8 px-4">
    <div class="bg-white rounded-2xl border border-[#ebebf0] shadow-sm overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-[#1a94ff] to-[#0b74e5] p-6 text-white text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/20 mb-3">
                <i class="fas fa-graduation-cap text-2xl"></i>
            </div>
            <h1 class="text-xl font-black uppercase">Xác Nhận Đăng Ký Khóa Học</h1>
            <p class="text-xs text-blue-100 mt-1">Kiểm tra thông tin chi tiết trước khi hoàn tất đăng ký</p>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-4">
            <div class="p-4 bg-[#fafafa] rounded-xl border border-[#ebebf0] space-y-3 text-xs">
                <div class="flex justify-between items-center">
                    <span class="text-[#808089]">Khóa học:</span>
                    <span class="font-bold text-[#27272a] text-right">@Model.TenKhoaHoc</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[#808089]">Mã khóa học:</span>
                    <span class="font-mono text-[#27272a]">@Model.IDKhoaHoc</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[#808089]">Giảng viên phụ trách:</span>
                    <span class="font-medium text-[#27272a]">@(Model.GiangVien != null ? Model.GiangVien.TenGV : "Hệ thống")</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[#808089]">Học viên đăng ký:</span>
                    <span class="font-bold text-[#27272a]">@ViewBag.TenHocVien</span>
                </div>
                <div class="pt-3 border-t border-[#ebebf0] flex justify-between items-center text-sm">
                    <span class="font-bold text-[#27272a]">Học phí:</span>
                    @if (isFree)
                    {
                        <span class="font-black text-lg text-[#00ab56]">0 ₫ (MIỄN PHÍ)</span>
                    }
                    else
                    {
                        <span class="font-black text-xl text-[#ff424e]">@gia.ToString("N0") ₫</span>
                    }
                </div>
            </div>

            @using (Html.BeginForm("DangKyKhoaHoc", "KhoaHoc", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IDKhoaHoc" />

                <div class="pt-2 flex items-center gap-3">
                    <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = Model.IDKhoaHoc })" 
                       class="w-1/3 py-3 rounded-xl border border-[#ebebf0] hover:bg-gray-50 text-center font-bold text-xs text-[#808089] transition">
                        Quay lại
                    </a>
                    <button type="submit" 
                            class="w-2/3 py-3 rounded-xl @(isFree ? "bg-[#00ab56] hover:bg-emerald-600" : "bg-[#ff424e] hover:bg-red-600") text-white font-black text-xs shadow transition flex items-center justify-center gap-2">
                        @if (isFree)
                        {
                            <i class="fas fa-play"></i> <span>Kích Hoạt &amp; Vào Học Ngay</span>
                        }
                        else
                        {
                            <i class="fas fa-credit-card"></i> <span>Xác Nhận &amp; Thanh Toán</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
</div>
