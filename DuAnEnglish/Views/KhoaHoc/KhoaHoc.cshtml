@model IEnumerable<DuAnEnglish.Models.KhoaHoc>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Danh Sách Khóa Học Trực Tuyến - TikiCourse";
    var dsDanhMuc = ViewBag.DanhSachDanhMuc as List<DuAnEnglish.Models.DanhMucKhoaHoc> ?? new List<DuAnEnglish.Models.DanhMucKhoaHoc>();
    string currentDm = ViewBag.CurrentDanhMuc as string ?? "all";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentGia = ViewBag.CurrentGia as string ?? "all";
    string currentSort = ViewBag.CurrentSort as string ?? "newest";
    var khList = Model != null ? Model.ToList() : new List<DuAnEnglish.Models.KhoaHoc>();
}

<!-- Breadcrumbs (Tiki Style) -->
<nav class="flex items-center gap-2 text-xs text-[#808089] mb-4">
    <a href="@Url.Action("Index", "Home")" class="hover:text-[#1a94ff] transition">Trang chủ</a>
    <span>&rsaquo;</span>
    <span class="text-[#27272a] font-medium">Khóa học trực tuyến</span>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-5">
    <!-- Left Sidebar: Tiki Filters -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm p-4 sticky top-24">
            <div class="flex items-center justify-between pb-3 border-b border-[#ebebf0] mb-4">
                <span class="font-bold text-xs uppercase tracking-wider text-[#27272a] flex items-center gap-1.5">
                    <i class="fas fa-filter text-[#1a94ff]"></i> Bộ lọc tìm kiếm
                </span>
                <a href="@Url.Action("KhoaHoc")" class="text-[11px] text-[#1a94ff] hover:underline">Xóa tất cả</a>
            </div>

            <form method="get" action="@Url.Action("KhoaHoc")" id="filterForm" class="space-y-5">
                <!-- Keyword Search in Sidebar -->
                <div>
                    <label class="block text-xs font-bold text-[#27272a] mb-1.5">Từ khóa tìm kiếm</label>
                    <div class="relative">
                        <input type="text" name="search" value="@currentSearch" 
                               placeholder="Tìm theo tên khóa học..." 
                               class="w-full pl-8 pr-3 py-2 text-xs border border-[#ebebf0] rounded-lg focus:outline-none focus:border-[#1a94ff]" />
                        <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                    </div>
                </div>

                <!-- Category Filter -->
                <div>
                    <label class="block text-xs font-bold text-[#27272a] mb-2">Danh mục chuyên môn</label>
                    <div class="space-y-1.5 text-xs text-[#27272a]">
                        <label class="flex items-center gap-2 cursor-pointer hover:text-[#1a94ff] transition">
                            <input type="radio" name="danhmuc" value="all" @(currentDm == "all" ? "checked" : "") 
                                   onchange="document.getElementById('filterForm').submit()" 
                                   class="text-[#1a94ff] focus:ring-0" />
                            <span>Tất cả danh mục</span>
                        </label>
                        @foreach (var dm in dsDanhMuc)
                        {
                            <label class="flex items-center gap-2 cursor-pointer hover:text-[#1a94ff] transition">
                                <input type="radio" name="danhmuc" value="@dm.IDDanhMuc" @(currentDm == dm.IDDanhMuc.ToString() ? "checked" : "") 
                                       onchange="document.getElementById('filterForm').submit()" 
                                       class="text-[#1a94ff] focus:ring-0" />
                                <span>@dm.TenDanhMuc</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Price Filter -->
                <div class="pt-3 border-t border-[#ebebf0]">
                    <label class="block text-xs font-bold text-[#27272a] mb-2">Mức học phí</label>
                    <div class="space-y-1.5 text-xs text-[#27272a]">
                        <label class="flex items-center gap-2 cursor-pointer hover:text-[#1a94ff] transition">
                            <input type="radio" name="gia" value="all" @(currentGia == "all" ? "checked" : "") 
                                   onchange="document.getElementById('filterForm').submit()" 
                                   class="text-[#1a94ff] focus:ring-0" />
                            <span>Tất cả mức giá</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-[#00ab56] transition">
                            <input type="radio" name="gia" value="free" @(currentGia == "free" ? "checked" : "") 
                                   onchange="document.getElementById('filterForm').submit()" 
                                   class="text-[#00ab56] focus:ring-0" />
                            <span class="text-[#00ab56] font-bold">Miễn phí (0 ₫)</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-[#ff424e] transition">
                            <input type="radio" name="gia" value="paid" @(currentGia == "paid" ? "checked" : "") 
                                   onchange="document.getElementById('filterForm').submit()" 
                                   class="text-[#ff424e] focus:ring-0" />
                            <span>Có phí (Trả phí qua VNPay)</span>
                        </label>
                    </div>
                </div>

                <!-- Lecturer Filter -->
                <div class="pt-3 border-t border-[#ebebf0]">
                    <label class="block text-xs font-bold text-[#27272a] mb-2">Giảng viên phụ trách</label>
                    <div class="text-xs text-[#808089] space-y-1">
                        <div class="flex items-center gap-2 text-[#27272a] font-medium">
                            <i class="fas fa-check-circle text-blue-500"></i> ThS. Huỳnh Phước
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-[#0b74e5] hover:bg-blue-700 text-white font-bold text-xs py-2 rounded-lg transition shadow-sm">
                        Áp dụng bộ lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Main Content: Course List -->
    <div class="lg:col-span-3">
        <!-- Result Header & Tiki Sort Bar -->
        <div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm p-4 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h1 class="text-base font-extrabold text-[#27272a]">
                    Khóa Học Trực Tuyến (@khList.Count kết quả)
                </h1>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <p class="text-xs text-[#808089]">Kết quả tìm kiếm cho: "<strong>@currentSearch</strong>"</p>
                }
            </div>

            <!-- Sort Pills -->
            <div class="flex items-center gap-2 text-xs flex-wrap">
                <span class="text-[#808089]">Ưu tiên xem:</span>
                <a href="@Url.Action("KhoaHoc", new { search = currentSearch, danhmuc = currentDm, gia = currentGia, sort = "newest" })" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition @(currentSort == "newest" ? "bg-[#e5f2ff] border-[#1a94ff] text-[#0b74e5]" : "border-[#ebebf0] text-[#27272a] hover:bg-gray-50")">
                    Mới nhất
                </a>
                <a href="@Url.Action("KhoaHoc", new { search = currentSearch, danhmuc = currentDm, gia = currentGia, sort = "price_asc" })" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition @(currentSort == "price_asc" ? "bg-[#e5f2ff] border-[#1a94ff] text-[#0b74e5]" : "border-[#ebebf0] text-[#27272a] hover:bg-gray-50")">
                    Giá thấp &rarr; cao
                </a>
                <a href="@Url.Action("KhoaHoc", new { search = currentSearch, danhmuc = currentDm, gia = currentGia, sort = "price_desc" })" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition @(currentSort == "price_desc" ? "bg-[#e5f2ff] border-[#1a94ff] text-[#0b74e5]" : "border-[#ebebf0] text-[#27272a] hover:bg-gray-50")">
                    Giá cao &rarr; thấp
                </a>
                <a href="@Url.Action("KhoaHoc", new { search = currentSearch, danhmuc = currentDm, gia = currentGia, sort = "name" })" 
                   class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition @(currentSort == "name" ? "bg-[#e5f2ff] border-[#1a94ff] text-[#0b74e5]" : "border-[#ebebf0] text-[#27272a] hover:bg-gray-50")">
                    Tên A-Z
                </a>
            </div>
        </div>

        @if (!khList.Any())
        {
            <div class="bg-white rounded-xl border border-[#ebebf0] p-12 text-center">
                <div class="w-16 h-16 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="text-base font-bold text-[#27272a] mb-1">Không tìm thấy khóa học phù hợp</h3>
                <p class="text-xs text-[#808089] mb-4">Hãy thử tìm với từ khóa khác hoặc điều chỉnh lại các tiêu chí lọc bên trái.</p>
                <a href="@Url.Action("KhoaHoc")" class="inline-block px-4 py-2 bg-[#1a94ff] text-white font-bold text-xs rounded-lg hover:bg-blue-600 transition">
                    Xem tất cả khóa học
                </a>
            </div>
        }
        else
        {
            <!-- Course Grid (3 cols) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                @foreach (var kh in khList)
                {
                    decimal gia = kh.HocPhi.HasValue ? kh.HocPhi.Value : 0;
                    bool isFree = gia == 0;
                    decimal giaGoc = isFree ? 990000 : gia * 1.4m;

                    <div class="bg-white rounded-lg border border-[#ebebf0] overflow-hidden flex flex-col justify-between tiki-card-hover group">
                        <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" class="block relative aspect-video bg-gray-100 overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(kh.HinhAnhKH) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80" : kh.HinhAnhKH)" 
                                 alt="@kh.TenKhoaHoc"
                                 class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                                 onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80'" />
                            
                            @if (isFree)
                            {
                                <span class="absolute top-2 left-2 bg-[#00ab56] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                                    MIỄN PHÍ
                                </span>
                            }
                            else
                            {
                                <span class="absolute top-2 left-2 bg-[#1a94ff] text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm">
                                    TikiPRO
                                </span>
                            }
                        </a>

                        <div class="p-3.5 flex flex-col flex-grow justify-between">
                            <div>
                                <div class="text-[11px] text-[#808089] mb-1 flex items-center justify-between">
                                    <span>@(kh.DanhMuc ?? "Công nghệ")</span>
                                    <span class="text-xs text-blue-500"><i class="fas fa-chalkboard-teacher"></i> ThS. Huỳnh Phước</span>
                                </div>
                                <h3 class="text-xs font-semibold text-[#27272a] line-clamp-2 group-hover:text-[#1a94ff] transition leading-snug mb-2">
                                    <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })">
                                        @kh.TenKhoaHoc
                                    </a>
                                </h3>
                                <p class="text-[11px] text-[#808089] line-clamp-2 mb-2">
                                    @(kh.MoTa ?? "Khóa học trực tuyến chất lượng cao với video HD và bài giảng thực hành chi tiết.")
                                </p>
                                <!-- Rating Stars -->
                                <div class="flex items-center gap-1.5 text-[11px] mb-2">
                                    <div class="flex text-[#ffc400] text-xs">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                    </div>
                                    <span class="text-[#808089]">(5.0)</span>
                                    <span class="text-gray-300">|</span>
                                    <span class="text-[#808089]">Đã học 1.2k</span>
                                </div>
                            </div>

                            <!-- Price Block -->
                            <div class="pt-2 border-t border-[#ebebf0]">
                                <div class="flex items-baseline gap-2">
                                    @if (isFree)
                                    {
                                        <span class="text-base font-extrabold text-[#00ab56]">0 ₫</span>
                                        <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                                    }
                                    else
                                    {
                                        <span class="text-base font-extrabold text-[#ff424e]">@gia.ToString("N0") ₫</span>
                                        <span class="text-xs text-[#808089] line-through">@giaGoc.ToString("N0") ₫</span>
                                    }
                                </div>
                                <div class="mt-2.5">
                                    <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = kh.IDKhoaHoc })" 
                                       class="w-full block text-center py-1.5 rounded-lg bg-[#e5f2ff] hover:bg-[#1a94ff] text-[#0b74e5] hover:text-white font-bold text-xs transition">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>