@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - TikiCourse</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
    <style>
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background-color: #f5f5fa; }
    </style>
</head>
<body class="min-h-screen w-full flex items-center justify-center p-4">

    <!-- Container Card (Tiki Auth Modal Style) -->
    <div class="bg-white w-full max-w-4xl rounded-2xl overflow-hidden shadow-xl border border-[#ebebf0] flex flex-col md:flex-row">

        <!-- Cột bên trái: Form đăng nhập -->
        <div class="w-full md:w-1/2 p-8 md:p-10 flex flex-col justify-between">
            <div>
                <!-- Brand Logo -->
                <div class="flex items-center gap-2 mb-6">
                    <div class="w-9 h-9 rounded-xl bg-[#1a94ff] text-white flex items-center justify-center font-black text-lg">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div>
                        <div class="text-xl font-black text-[#1a94ff] tracking-tight">Tiki<span class="text-yellow-400">Course</span></div>
                        <div class="text-[9px] text-[#808089] uppercase tracking-wider font-semibold">Tốt &amp; Nhanh &bull; Học Trực Tuyến</div>
                    </div>
                </div>

                <h1 class="text-2xl font-black text-[#27272a] mb-1">
                    Xin chào!
                </h1>
                <p class="text-xs text-[#808089] mb-6">
                    Đăng nhập hoặc <a href="@Url.Action("DangKy", "DangKy")" class="text-[#1a94ff] font-bold hover:underline">tạo tài khoản mới</a> để truy cập khóa học.
                </p>

                <!-- Form đăng nhập -->
                @using (Html.BeginForm("DangNhap", "DangNhap", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-[#27272a] mb-1">
                                Tên đăng nhập
                            </label>
                            <div class="relative">
                                <i class="far fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                <input type="text" name="TenDangNhap"
                                       class="w-full pl-9 pr-3 py-2.5 text-xs border border-[#ebebf0] rounded-lg focus:outline-none focus:border-[#1a94ff] transition"
                                       placeholder="Nhập tên đăng nhập (ví dụ: phuc, admin, phuoc)" required />
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-bold text-[#27272a]">
                                    Mật khẩu
                                </label>
                                <a href="@Url.Action("DoiMatKhau", "DoiMatKhau")" class="text-[11px] text-[#1a94ff] hover:underline">
                                    Quên mật khẩu?
                                </a>
                            </div>
                            <div class="relative">
                                <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                <input type="password" name="MatKhau"
                                       class="w-full pl-9 pr-3 py-2.5 text-xs border border-[#ebebf0] rounded-lg focus:outline-none focus:border-[#1a94ff] transition"
                                       placeholder="Nhập mật khẩu của bạn" required />
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full py-2.5 bg-[#ff424e] hover:bg-red-600 text-white font-bold text-xs rounded-lg transition shadow-sm mt-2 flex items-center justify-center gap-2">
                            <span>Đăng nhập</span>
                            <i class="fas fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>
                }

                <!-- Quick Accounts Hint for Demo -->
                <div class="mt-6 p-3 bg-[#f5f5fa] rounded-lg border border-[#ebebf0] text-[11px] text-[#808089]">
                    <div class="font-bold text-[#27272a] mb-1">Tài khoản thử nghiệm hệ thống:</div>
                    <div>&bull; <strong>Học viên:</strong> phuc / 123</div>
                    <div>&bull; <strong>Giảng viên:</strong> phuoc / 123</div>
                    <div>&bull; <strong>Quản trị viên:</strong> admin / 123</div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#ebebf0] text-center text-xs text-[#808089]">
                Chưa có tài khoản?
                <a href="@Url.Action("DangKy", "DangKy")" class="text-[#1a94ff] font-bold hover:underline ml-1">
                    Đăng ký ngay
                </a>
            </div>
        </div>

        <!-- Cột bên phải: Banner Tiki Hero -->
        <div class="hidden md:flex w-1/2 bg-gradient-to-br from-[#0b74e5] to-[#1a94ff] p-10 flex-col justify-between text-white relative overflow-hidden">
            <div class="relative z-10">
                <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-yellow-300 text-[10px] font-bold uppercase tracking-wider mb-4 border border-white/20">
                    Nền Tảng Đào Tạo Số
                </span>
                <h2 class="text-2xl font-black leading-snug mb-3">
                    Học Lập Trình &amp; Ngoại Ngữ Trực Tuyến Đỉnh Cao
                </h2>
                <p class="text-xs text-blue-100 leading-relaxed">
                    Hơn hàng trăm bài giảng video chất lượng cao, tài liệu đính kèm đầy đủ và hỗ trợ giải đáp đồ án chuyên nghiệp.
                </p>
            </div>

            <div class="relative z-10 space-y-3 my-6">
                <div class="flex items-center gap-2.5 text-xs text-blue-100">
                    <i class="fas fa-check-circle text-yellow-300"></i>
                    <span>Tích hợp thanh toán an toàn qua VNPay</span>
                </div>
                <div class="flex items-center gap-2.5 text-xs text-blue-100">
                    <i class="fas fa-check-circle text-yellow-300"></i>
                    <span>Tự động kích hoạt khóa học vào học ngay</span>
                </div>
                <div class="flex items-center gap-2.5 text-xs text-blue-100">
                    <i class="fas fa-check-circle text-yellow-300"></i>
                    <span>Theo dõi tiến độ phần trăm bài học trực quan</span>
                </div>
            </div>

            <div class="relative z-10 text-[11px] text-blue-200">
                &copy; 2026 TikiCourse. All rights reserved.
            </div>

            <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        </div>
    </div>

    <!-- SweetAlert Thông báo lỗi nếu có -->
    @if (ViewBag.ThongBao != null)
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'Thông báo',
                text: '@Html.Raw(ViewBag.ThongBao)',
                confirmButtonColor: '#1a94ff'
            });
        </script>
    }

</body>
</html>
