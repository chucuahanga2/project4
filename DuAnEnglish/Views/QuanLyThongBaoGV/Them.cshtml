@{
    if (Session["Role"] != null)
    {
        var role = Session["Role"].ToString().ToLower();
        if (role == "admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        }
        else if (role == "giangvien")
        {
            Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
        }
    }
}

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-7xl">
        @using (Html.BeginForm("Them", "QuanLyThongBaoGV", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-7xl">
                <div class="mt-4">
                    <a href="@Url.Action("QuanLyThongBaoGV", "QuanLyThongBaoGV")" class="inline-block py-2 px-4 text-sm font-medium rounded-lg bg-red-600 text-white hover:bg-red-500">
                        <i class="fas fa-arrow-left"></i> Trở lại
                    </a>
                </div>
                <h2 class="text-3xl font-bold text-center text-red-600 mb-6">Thêm Thông Báo Mới</h2>
                <div class="mb-6">
                    <label for="TieuDe" class="block text-lg font-medium text-gray-700">Tiêu Đề:</label>
                    <input type="text" id="TieuDe" name="TieuDe"
                           class="mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-300"
                           placeholder="Nhập tiêu đề thông báo" required />
                </div>

                <div class="mb-6">
                    <label for="NoiDung" class="block text-lg font-medium text-gray-700">Nội Dung:</label>
                    <textarea id="NoiDung" name="NoiDung" rows="6"
                              class="mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-300"
                              placeholder="Nhập nội dung thông báo" required></textarea>
                </div>


                <div class="flex justify-center mt-8">
                    <button type="submit" class="py-2 px-6 text-lg font-medium text-white bg-green-500 hover:bg-green-600 rounded-lg">
                        Thêm
                    </button>
                </div>
            </div>
        }
    </div>
</div>




<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
            // Gọi hàm showAlert từ file JSThongBao.js
            showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
