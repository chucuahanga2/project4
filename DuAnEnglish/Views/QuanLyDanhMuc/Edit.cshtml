@model DuAnEnglish.Models.DanhMucKhoaHoc
@{
    ViewBag.Title = "Chỉnh sửa Danh Mục Khóa Học";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">CHỈNH SỬA DANH MỤC KHÓA HỌC</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh mục
    </a>
</div>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-edit mr-1"></i> Cập Nhật Danh Mục: #@Model.IDDanhMuc</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Edit", "QuanLyDanhMuc", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.IDDanhMuc)

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Tên Danh Mục <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "form-control", required = "required" })
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Thứ Tự Ưu Tiên</label>
                            @Html.TextBoxFor(m => m.ThuTu, new { @class = "form-control", type = "number" })
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Trạng Thái</label>
                            <select name="TrangThai" class="form-control">
                                <option value="Hoạt động" @(Model.TrangThai == "Hoạt động" ? "selected" : "")>Hoạt động</option>
                                <option value="Khóa" @(Model.TrangThai == "Khóa" ? "selected" : "")>Khóa / Tạm ẩn</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Mô Tả Danh Mục</label>
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("Index")" class="btn btn-secondary mr-2">
                            <i class="fas fa-times mr-1"></i> Hủy Bỏ
                        </a>
                        <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                            <i class="fas fa-save mr-1"></i> Cập Nhật
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
