@{
    ViewBag.Title = "_LayoutAdmin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        /* Đảm bảo các action con hiển thị bên cạnh */
        .menu-con {
            position: absolute;
            left: 100%; /* Đẩy menu con ra bên phải */
            top: 0;
            display: none; /* Ẩn menu con mặc định */
            background-color: white;
            color: black;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: 200px; /* Chiều rộng của menu con */
            z-index: 50; /* Đảm bảo menu con xuất hiện phía trên các phần tử khác */
        }

        /* Hiển thị menu con khi hover vào mục cha */
        .relative.group:hover .menu-con {
            display: block;
        }

        .menu-con a {
            padding: 0.5rem 1rem;
            text-decoration: none;
            display: block;
        }

            .menu-con a:hover {
                background-color: #f3f4f6; /* Màu hover */
            }
    </style>
</head>
<body class="bg-gray-50">
    <div class="flex">
        <!-- Sidebar cố định -->
        <aside class="fixed top-0 left-0 h-full w-64 bg-[#ce3235] p-6 text-white flex flex-col space-y-6">
            <!-- Logo -->
            <a href="@Url.Action("Index", "HomeAdmin")" class="flex items-center space-x-2">
                <h2 class="text-3xl font-bold tracking-wide text-white">MY ADMIN</h2>
            </a>

            <!-- Navigation -->
            <nav class="flex flex-col space-y-4 text-sm font-medium">

                <a href="@Url.Action("QuanLyTaiKhoan", "QuanLyTaiKhoan")" class="hover:text-gray-200">QUẢN LÝ TÀI KHOẢN</a>
                <a href="@Url.Action("QuanLyGiangVien", "QuanLyGiangVien")" class="hover:text-gray-200">QUẢN LÝ GIẢNG VIÊN</a>
                <a href="@Url.Action("QuanLyKhoaHoc", "QuanLyKhoaHoc")" class="hover:text-gray-200">QUẢN LÝ KHÓA HỌC</a>
                <a href="@Url.Action("QuanLyLopHoc", "QuanLyLopHoc")" class="hover:text-gray-200">QUẢN LÝ LỚP HỌC</a>
                <a href="@Url.Action("QuanLyThanhToan", "QuanLyThanhToan")" class="hover:text-gray-200">QUẢN LÝ THANH TOÁN</a>
                <a href="@Url.Action("QuanLyPhongHoc", "QuanLyPhongHoc")" class="hover:text-gray-200">QUẢN LÝ PHÒNG HỌC</a>
                <a href="@Url.Action("QuanLyThongBaoGV", "QuanLyThongBaoGV")" class="hover:text-gray-200">QUẢN LÝ THÔNG BÁO</a>
                <a href="@Url.Action("QuanLyChatBot", "QuanLyChatBot")" class="hover:text-gray-200">QUẢN LÝ CHATBOT</a>
                <a href="@Url.Action("BaoCaoThongKe", "QLBaoCaoThongKe")" class="hover:text-gray-200">BÁO CÁO THỐNG KÊ</a>
            </nav>

            <!-- Logout -->
            <a href="@Url.Action("DangXuat", "DangNhap")"
               class="mt-auto text-center bg-white text-red-600 font-semibold py-2 rounded-md transition-colors duration-300 hover:bg-gray-800 hover:text-white">
                Đăng Xuất
            </a>
        </aside>

        <!-- Nội dung trang - đẩy sang phải để không bị sidebar đè lên -->
        <main class="ml-64 flex-1 p-6">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
