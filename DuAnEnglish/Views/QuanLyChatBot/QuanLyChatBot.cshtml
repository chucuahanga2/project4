@model IEnumerable<DuAnEnglish.Models.ChatBotNoiDung>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý nội dung chatbot";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex justify-center bg-gray-100">
    <div class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-6xl">
        
        <h2 class="text-3xl font-bold text-center text-red-600 mb-6">
            Quản lý nội dung chatbot
        </h2>

        <p class="mb-4">
            @Html.ActionLink(
              "+ Thêm mới",
              "Them",
              "QuanLyChatBot",
              null,
              new { @class = "bg-green-500 hover:bg-green-600 text-white font-medium py-2 px-4 rounded shadow" }
            )
        </p>

        @if (!Model.Any())
        {
            <div class="text-center text-gray-500 text-lg italic">
                Hiện chưa có nội dung nào
            </div>
        }
        else
        {
            <table class="table-auto w-full border border-gray-300 text-center">
                <thead class="bg-red-500 text-white">
                    <tr>
                        <th class="py-3 px-4 border">Mã Chat</th>
                        <th class="py-3 px-4 border">Câu hỏi mẫu</th>
                        <th class="py-3 px-4 border">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border border-gray-300 hover:bg-gray-50">
                            <td class="py-2 px-4 border">@item.MaChat</td>
                            <td class="py-2 px-4 border">@item.CauHoiMau</td>
                            <td class="py-2 px-4 border">
                                <a href="@Url.Action("ChiTiet","QuanLyChatBot", new { id = item.MaChat })"
                                   class="inline-block bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded mr-1 shadow my-0.5">Chi tiết</a>
                                <a href="@Url.Action("Xoa","QuanLyChatBot", new { id = item.MaChat })"
                                   class="btn-xoa inline-block bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded shadow my-0.5">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script src="~/Scripts/JSThongBao.js"></script>
<script src="~/Scripts/JSXacNhanXoa.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
            // Gọi hàm showAlert từ file JSThongBao.js
            showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}