@model DuAnEnglish.Models.ChatBotNoiDung

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Sửa Nội Dung ChatBot";
}

<div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg mt-10 p-8">
    <div class="mt-4">
        <a href="@Url.Action("QuanLyChatBot", "QuanLyChatBot")" class="inline-block py-2 px-4 mb-8 text-sm font-medium rounded-lg bg-red-600 text-white hover:bg-red-500">
            <i class="fas fa-arrow-left"></i> Trở lại
        </a>
    </div>
    <h2 class="text-2xl font-bold text-center text-red-600 mb-8">Chi Tiết Nội Dung ChatBot</h2>

    @using (Html.BeginForm("ChiTiet", "QuanLyChatBot", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaChat)

        <div class="space-y-6">
            <div>
                <label for="CauHoiMau" class="block text-gray-700 font-semibold mb-2">Câu hỏi:</label>
                @Html.TextBoxFor(m => m.CauHoiMau, new { @class = "w-full border border-gray-300 rounded px-4 py-2 bg-white" })
            </div>

            <div>
                <label for="TuKhoa" class="block text-gray-700 font-semibold mb-2">Từ khóa:</label>
                @Html.TextBoxFor(m => m.TuKhoa, new { @class = "w-full border border-gray-300 rounded px-4 py-2 bg-white" })
            </div>

            <div>
                <label for="CauTraLoi" class="block text-gray-700 font-semibold mb-2">Câu trả lời:</label>
                @Html.TextAreaFor(m => m.CauTraLoi, new { rows = 6, @class = "w-full border border-gray-300 rounded px-4 py-2 bg-white" })
            </div>

            <div class="text-center">
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-6 rounded">
                    Sửa
                </button>
            </div>
        </div>
    }
</div>
