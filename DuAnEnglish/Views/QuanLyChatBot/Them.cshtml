@model DuAnEnglish.Models.ChatBotNoiDung

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Thêm Nội Dung ChatBot";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>


<div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg mt-10 p-8">
    <!-- Back button -->
    <a href="@Url.Action("QuanLyChatBot", "QuanLyChatBot")"
       class="inline-flex items-center bg-red-500 hover:bg-red-600 text-white font-medium py-2 px-4 rounded mb-6">
        <i class="fas fa-arrow-left mr-2"></i>Trở lại
    </a>

    <!-- Title -->
    <h2 class="text-2xl font-bold text-center text-red-600 mb-8">Thêm Nội Dung ChatBot</h2>

    @using (Html.BeginForm("Them", "QuanLyChatBot", FormMethod.Post, new { @class = "space-y-6" }))
    {
        @Html.AntiForgeryToken()
        <div>
            <label for="CauHoiMau" class="block text-gray-700 font-semibold mb-2">Câu hỏi:</label>
            @Html.TextBoxFor(model => model.CauHoiMau, new
            {
                id = "CauHoiMau",
                @class = "w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400",
                placeholder = "Nhập câu hỏi"
            })
            @Html.ValidationMessageFor(model => model.CauHoiMau, "", new { @class = "text-red-500 text-sm mt-1" })
        </div>

        <div>
            <label for="TuKhoa" class="block text-gray-700 font-semibold mb-2">Từ khóa:</label>
            @Html.TextBoxFor(model => model.TuKhoa, new
            {
                id = "TuKhoa",
                @class = "w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400",
                placeholder = "Nhập từ khóa (cách nhau bởi dấu phẩy)"
            })
            @Html.ValidationMessageFor(model => model.TuKhoa, "", new { @class = "text-red-500 text-sm mt-1" })
        </div>

        <div>
            <label for="CauTraLoi" class="block text-gray-700 font-semibold mb-2">Câu trả lời:</label>
            @Html.TextAreaFor(model => model.CauTraLoi, new
            {
                id = "CauTraLoi",
                rows = 6,
                @class = "w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400",
                placeholder = "Nhập câu trả lời"
            })
            @Html.ValidationMessageFor(model => model.CauTraLoi, "", new { @class = "text-red-500 text-sm mt-1" })
        </div>

        <div class="text-center">
            <button type="submit"
                    class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-6 rounded">
                Thêm
            </button>
        </div>
    }
</div>
<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
            // Gọi hàm showAlert từ file JSThongBao.js
            showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}