@model DuAnEnglish.Models.HocVien
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Hồ sơ cá nhân";
    var tk = Model.TaiKhoan;
}

<div class="max-w-4xl mx-auto py-6">
    <!-- Breadcrumbs -->
    <div class="mb-6 flex items-center text-xs text-gray-500 gap-2">
        <a href="@Url.Action("Index", "Home")" class="hover:text-blue-600">Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("KhoaHocCuaToi", "HocTap")" class="hover:text-blue-600">Khóa học của tôi</a>
        <span>/</span>
        <span class="text-gray-800 font-semibold">Hồ sơ cá nhân</span>
    </div>

    @if (ViewBag.ThongBao != null)
    {
        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
            <i class="fas fa-check-circle text-emerald-500 text-lg"></i>
            <span>@ViewBag.ThongBao</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Sidebar Info -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-3xl border border-gray-200/80 shadow-sm p-6 text-center">
                <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-black text-3xl mx-auto mb-4 shadow-lg">
                    @(string.IsNullOrEmpty(Model.TenHV) ? "U" : Model.TenHV.Substring(0, 1).ToUpper())
                </div>
                <h3 class="font-black text-gray-900 text-lg">@Model.TenHV</h3>
                <p class="text-xs text-gray-500 mb-4">@@@Model.IDTenDangNhap</p>

                <div class="p-3 bg-blue-50 rounded-2xl border border-blue-100 text-xs text-blue-800 font-bold mb-4">
                    <i class="fas fa-user-graduate mr-1"></i> Học Viên Chính Thức
                </div>

                <div class="text-left pt-4 border-t border-gray-100 space-y-2 text-xs text-gray-600">
                    <div><strong>Mã học viên:</strong> #@Model.IDHocVien</div>
                    <div><strong>Email:</strong> @(tk != null && !string.IsNullOrEmpty(tk.Email) ? tk.Email : "Chưa cập nhật")</div>
                    <div><strong>SĐT:</strong> @(tk != null && !string.IsNullOrEmpty(tk.SDT) ? tk.SDT : "Chưa cập nhật")</div>
                </div>

                <div class="mt-6 pt-4 border-t border-gray-100">
                    <a href="@Url.Action("DoiMatKhau", "DoiMatKhau")" class="block w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition">
                        <i class="fas fa-key mr-1"></i> Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>

        <!-- Update Form -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-3xl border border-gray-200/80 shadow-sm p-6 md:p-8">
                <h2 class="text-xl font-black text-gray-900 mb-6 flex items-center gap-2">
                    <i class="fas fa-user-edit text-blue-600"></i>
                    <span>Cập Nhật Thông Tin Cá Nhân</span>
                </h2>

                @using (Html.BeginForm("ThongTinCaNhan", "HocTap", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tên đăng nhập</label>
                            <input type="text" value="@Model.IDTenDangNhap" class="w-full px-4 py-2.5 bg-gray-100 border border-gray-200 rounded-xl text-sm font-bold text-gray-600 cursor-not-allowed" readonly />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Họ và tên học viên <span class="text-danger">*</span></label>
                            <input type="text" name="TenHV" value="@Model.TenHV" required class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Địa chỉ Email</label>
                                <input type="email" name="Email" value="@(tk != null ? tk.Email : "")" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Số điện thoại</label>
                                <input type="tel" name="SDT" value="@(tk != null ? tk.SDT : "")" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Địa chỉ liên hệ</label>
                            <input type="text" name="DiaChi" value="@Model.DiaChi" placeholder="Nhập tỉnh/thành phố, quận/huyện..." class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                        </div>

                        <div class="pt-6 border-t border-gray-100 flex justify-end">
                            <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-sm rounded-xl transition duration-200 shadow-md flex items-center gap-2">
                                <i class="fas fa-save"></i>
                                <span>Lưu thay đổi</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
