@model IEnumerable<DuAnEnglish.Models.HocVien>
@{
    Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
    ViewBag.Title = "Quản Lý Học Viên";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<div class="container mx-auto px-4 py-6">
    <h2 class="text-2xl font-bold text-red-800">Danh Sách Học Viên</h2>
    <!-- Phần hiển thị lớp -->
    <div class="mb-6">
        <form method="get" action="@Url.Action("QuanLyHocVien", "QuanLyHocVien")">
            <div class="flex items-center gap-4">
                <span class="text-lg font-semibold text-gray-700">Lớp:</span>
                <select name="idLop" class="w-48 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="this.form.submit()">
                    <option value="">-- Chọn lớp --</option>
                    @foreach (var lop in ViewBag.DanhSachLop)
                    {
                        <option value="@lop.IDLopHoc" @(ViewBag.IDLopDangChon == lop.IDLopHoc ? "selected" : "")>@lop.TenLop</option>
                    }
                </select>
            </div>
        </form>
    </div>


    <!-- Phần tiêu đề và nút thêm -->
    <form method="get" action="@Url.Action("Them", "QuanLyHocVien")">
        <input type="hidden" name="idLop" value="@ViewBag.IDLopDangChon" />
        <button type="submit"
                class="w-[140px] bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors flex items-center gap-2 text-center">
            Thêm Học Viên
        </button>
    </form>


    <!-- Bảng danh sách -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Mã HV</th>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Tên đăng nhập</th>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Họ tên</th>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Ngày sinh</th>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Giới tính</th>
                    <th class="px-6 py-3 font-bold text-left text-sm text-black uppercase tracking-wider">Địa chỉ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (!Model.Any())
                {
                    <tr>
                        <!-- colspan điều chỉnh theo số cột -->
                        <td colspan="6" class="text-center px-4 py-2 border-b border-gray-200">
                            Vui lòng chọn lớp để xem danh sách !
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var hocVien in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@hocVien.IDHocVien</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@hocVien.TaiKhoan.TenDangNhap</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@hocVien.TenHV</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                                @if (hocVien.NgaySinh.HasValue)
                                {
                                    @hocVien.NgaySinh.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-gray-400">N/A</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                                      @(hocVien.GioiTinh == "Nam" ? "" : "")">
                                    @hocVien.GioiTinh
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@hocVien.DiaChi</td>
                            <td>
                                <a href="@Url.Action("Xoa", "QuanLyHocVien", new { id = hocVien.IDHocVien })"
                                   class="btn-xoa bg-red-600 hover:bg-red-600 text-white font-semibold py-1 px-3 rounded">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

<script src="~/Scripts/JSThongBao.js"></script>
<script src="~/Scripts/JSXacNhanXoa.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}