@model DuAnEnglish.Models.HocVien
@{
    ViewBag.Title = "Chi tiết Học viên: " + (Model.TenHV ?? Model.IDTenDangNhap);
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string tt = Model.TaiKhoan != null ? Model.TaiKhoan.TrangThai : "Hoạt động";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">CHI TIẾT HỌC VIÊN #@Model.IDHocVien</h1>
    <a href="@Url.Action("QuanLyHocVien")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
    </a>
</div>

<div class="row">
    <!-- Thông tin cá nhân -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-circle mr-1"></i> Hồ Sơ Học Viên</h6>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-user-circle fa-5x text-gray-300"></i>
                </div>
                <h5 class="font-weight-bold text-gray-800">@(Model.TenHV ?? Model.IDTenDangNhap)</h5>
                <p class="text-muted small">Tên đăng nhập: <strong>@Model.IDTenDangNhap</strong></p>

                <div class="text-left mt-4 border-top pt-3">
                    <p><strong>Email:</strong> @(Model.TaiKhoan != null && !string.IsNullOrEmpty(Model.TaiKhoan.Email) ? Model.TaiKhoan.Email : "Chưa cập nhật")</p>
                    <p><strong>Số điện thoại:</strong> @(Model.TaiKhoan != null && !string.IsNullOrEmpty(Model.TaiKhoan.SDT) ? Model.TaiKhoan.SDT : "Chưa cập nhật")</p>
                    <p><strong>Ngày sinh:</strong> @(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</p>
                    <p><strong>Giới tính:</strong> @(Model.GioiTinh ?? "Chưa cập nhật")</p>
                    <p><strong>Địa chỉ:</strong> @(Model.DiaChi ?? "Chưa cập nhật")</p>
                    <p>
                        <strong>Trạng thái:</strong> 
                        @if (tt == "Hoạt động")
                        {
                            <span class="badge badge-status-active">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge badge-status-locked">Đã khóa</span>
                        }
                    </p>
                </div>

                <div class="mt-3">
                    @using (Html.BeginForm("KhoaMoTaiKhoan", "QuanLyHocVien", new { id = Model.IDHocVien }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="btn @(tt == "Khóa" ? "btn-success" : "btn-warning") btn-block shadow-sm font-weight-bold"
                                onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản học viên này?');">
                            <i class="fas @(tt == "Khóa" ? "fa-unlock" : "fa-lock") mr-1"></i>
                            @(tt == "Khóa" ? "Mở Khóa Tài Khoản" : "Khóa Tài Khoản")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Khóa học đã ghi danh -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-book-reader mr-1"></i> Khóa Học Đang Theo Học (@(Model.DangKyKhoaHocs != null ? Model.DangKyKhoaHocs.Count : 0))
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th>Khóa Học</th>
                                <th style="width: 110px;" class="text-center">Ngày ĐK</th>
                                <th style="width: 150px;">Tiến Độ Học</th>
                                <th style="width: 150px;">Điểm & Đánh Giá</th>
                                <th style="width: 130px;" class="text-center">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DangKyKhoaHocs != null && Model.DangKyKhoaHocs.Count > 0)
                            {
                                var tienDoDict = ViewBag.TienDoDict as System.Collections.Generic.Dictionary<int, Tuple<int, int, int>>;
                                foreach (var dk in Model.DangKyKhoaHocs)
                                {
                                    int soBai = 0;
                                    int tongBai = 0;
                                    int phanTram = 0;
                                    if (tienDoDict != null && tienDoDict.ContainsKey(dk.IDDangKy))
                                    {
                                        soBai = tienDoDict[dk.IDDangKy].Item1;
                                        tongBai = tienDoDict[dk.IDDangKy].Item2;
                                        phanTram = tienDoDict[dk.IDDangKy].Item3;
                                    }

                                    <tr>
                                        <td>
                                            <div class="font-weight-bold text-primary">
                                                @(dk.KhoaHoc != null ? dk.KhoaHoc.TenKhoaHoc : dk.IDKhoaHoc)
                                            </div>
                                            <div class="small text-muted">
                                                Mã KH: <strong>@dk.IDKhoaHoc</strong>
                                            </div>
                                        </td>
                                        <td class="text-center small text-muted">
                                            @(dk.NgayDangKy.HasValue ? dk.NgayDangKy.Value.ToString("dd/MM/yyyy") : "N/A")
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>@soBai/@tongBai bài</span>
                                                <span class="font-weight-bold @(phanTram == 100 ? "text-success" : "text-primary")">@phanTram%</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @(phanTram == 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @phanTram%" aria-valuenow="@phanTram" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (dk.DiemKhoaHoc != null && dk.DiemKhoaHoc.Diem.HasValue)
                                            {
                                                <div>
                                                    <span class="badge badge-success font-weight-bold">
                                                        <i class="fas fa-star mr-1"></i>@dk.DiemKhoaHoc.Diem.Value.ToString("0.0") / 10
                                                    </span>
                                                </div>
                                                if (!string.IsNullOrEmpty(dk.DiemKhoaHoc.NhanXet))
                                                {
                                                    <div class="small text-muted mt-1 font-italic text-truncate" style="max-width: 140px;" title="@dk.DiemKhoaHoc.NhanXet">
                                                        "@dk.DiemKhoaHoc.NhanXet"
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-light border text-muted">Chưa chấm</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (dk.TrangThai == "Đã hoàn thành")
                                            {
                                                <span class="badge badge-success">Đã hoàn thành</span>
                                            }
                                            else if (dk.TrangThai == "Đã kích hoạt")
                                            {
                                                <span class="badge badge-status-active">Đang học</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-status-pending">Chờ kích hoạt</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Học viên này chưa đăng ký khóa học nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
