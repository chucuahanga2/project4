@model List<DuAnEnglish.Models.KhoaHoc>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "QuanLyKhoaHoc";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex  justify-center bg-gray-100">
    <div class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-6xl">
        <h2 class="text-3xl font-bold text-center text-red-600 mb-6">Quản lý khóa học</h2>

        <div class="container mx-auto px-4 py-8">
            <div class="flex justify-center mb-8">
                <div class="inline-flex rounded-full bg-gray-100 p-1 shadow-inner">
                    <a href="@Url.Action("QuanLyKhoaHoc", "QuanLyKhoaHoc", new { danhmuc = "all" })"
                       class="px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 hover:bg-white hover:shadow-md hover:text-[#00aab5] mx-1">
                        Tất cả
                    </a>
                    <a href="@Url.Action("QuanLyKhoaHoc", "QuanLyKhoaHoc", new { danhmuc = "TOEIC" })"
                       class="px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 hover:bg-white hover:shadow-md hover:text-[#00aab5] mx-1">
                        TOEIC
                    </a>
                    <a href="@Url.Action("QuanLyKhoaHoc", "QuanLyKhoaHoc", new { danhmuc = "IELTS" })"
                       class="px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 hover:bg-white hover:shadow-md hover:text-[#00aab5] mx-1">
                        IELTS
                    </a>

                </div>
            </div>

        </div>
        <p class="mb-4">
            @Html.ActionLink("+ Thêm mới", "Create", "QuanLyKhoaHoc", null, new
            {
                @class = "bg-green-500 hover:bg-green-600 text-white font-medium py-2 px-4 rounded shadow"
            })
        </p>
        <div class="flex justify-end mb-4">
            <form method="get" action="@Url.Action("QuanLyKhoaHoc", "QuanLyKhoaHoc")" class="flex items-center space-x-2">
                <input type="text" name="search" value="@Request["search"]" placeholder="Nhập mã khóa học..."
                       class="border border-gray-300 rounded px-3 py-2 text-sm placeholder-gray-400 w-72" />
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white text-sm px-4 py-2 rounded">
                    Tìm kiếm
                </button>
            </form>
        </div>
        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-gray-500 text-lg italic">Hiện chưa có thông báo nào</div>
        }
        else
        {
            <table class="table-auto w-full border border-gray-300 text-center">
                <thead class="bg-red-500 text-white">
                    <tr>
                        <th class="py-3 px-4 border">Mã khóa học</th>
                        <th class="py-3 px-4 border">Tên khóa học</th>
                        <th class="py-3 px-4 border">Mô tả</th>
                        <th class="py-3 px-4 border">Học phí</th>
                        <th class="py-3 px-4 border">Hình ảnh</th>
                        <th class="py-3 px-4 border">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr class="border-b border-gray-300 hover:bg-gray-50">
                            <td>@kh.IDKhoaHoc</td>
                            <td>@kh.TenKhoaHoc</td>
                            <td class="py-2 px-4 truncate max-w-xs" title="@kh.MoTa">@kh.MoTa</td>
                            <td>@kh.HocPhi</td>
                            <td class="py-2 px-4">
                                <img src="@Url.Content("~/Images/" + kh.HinhAnhKH)" class="w-20 h-16 object-cover rounded" />
                            </td>
                            <td class="py-2 px-4">
                                <a href="@Url.Action("details", new { id = kh.IDKhoaHoc })"
                                   class="inline-block bg-green-500 hover:bg-green-600 text-white py-1 px-3 rounded mr-1 shadow my-0.5">
                                    Chi tiết
                                </a>

                                <a href="@Url.Action("Delete", new { id = kh.IDKhoaHoc })"
                                   class="btn-xoa inline-block bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded shadow my-0.5">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
<script src="~/Scripts/JSThongBao.js"></script>
<script src="~/Scripts/JSXacNhanXoa.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
            // Gọi hàm showAlert từ file JSThongBao.js
            showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}