@model IEnumerable<DuAnEnglish.Models.KhoaHoc>
@{
    ViewBag.Title = "Quản lý Khóa học";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var dsDanhMuc = ViewBag.DanhSachDanhMuc as List<DuAnEnglish.Models.DanhMucKhoaHoc> ?? new List<DuAnEnglish.Models.DanhMucKhoaHoc>();
    string currentDm = ViewBag.CurrentDanhMuc as string ?? "all";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800 font-weight-bold">QUẢN LÝ KHÓA HỌC</h1>
<p class="mb-4">Theo dõi toàn bộ danh sách khóa học trực tuyến, cập nhật giáo trình, giảng viên phụ trách và kiểm soát trạng thái hiển thị.</p>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- DataTales Card (SB Admin 2 format) -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-book-reader mr-1"></i> Danh Sách Khóa Học Hệ Thống (@(Model != null ? Model.Count() : 0))
        </h6>
        <div class="mt-2 mt-md-0">
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm font-weight-bold">
                <i class="fas fa-plus fa-sm mr-1"></i> Thêm Khóa Học Mới
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Search and Filter Toolbar -->
        <form method="get" action="@Url.Action("QuanLyKhoaHoc")" class="mb-3">
            <div class="form-row align-items-center">
                <div class="col-md-4 my-1">
                    <div class="input-group">
                        <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm theo mã, tên khóa học hoặc giảng viên...">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 my-1">
                    <select name="danhmuc" class="form-control" onchange="this.form.submit()">
                        <option value="all" @(currentDm == "all" ? "selected" : "")>-- Tất cả danh mục --</option>
                        @foreach (var dm in dsDanhMuc)
                        {
                            <option value="@dm.IDDanhMuc" @(currentDm == dm.IDDanhMuc.ToString() ? "selected" : "")>@dm.TenDanhMuc</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 my-1">
                    <a href="@Url.Action("QuanLyKhoaHoc")" class="btn btn-secondary btn-block">
                        <i class="fas fa-sync-alt mr-1"></i> Làm mới
                    </a>
                </div>
            </div>
        </form>

        <!-- 5-Column Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 70px;" class="text-center">STT</th>
                        <th>Khóa học</th>
                        <th>Danh mục & Giảng viên</th>
                        <th style="width: 170px;">Học phí & Trạng thái</th>
                        <th style="width: 150px;" class="text-center">Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            string imgUrl = !string.IsNullOrEmpty(item.HinhAnhKH) ? Url.Content("~/Images/" + item.HinhAnhKH) : Url.Content("~/Images/default_course.png");
                            <tr>
                                <!-- Cột 1: STT & Mã -->
                                <td class="text-center font-weight-bold text-muted">
                                    @stt
                                    <div class="small badge badge-light border">@item.IDKhoaHoc</div>
                                </td>

                                <!-- Cột 2: Tên khóa học & Hình ảnh -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@imgUrl" class="rounded mr-2 shadow-sm" style="width: 60px; height: 45px; object-fit: cover;" onerror="this.src='/Images/TI_CoBan.jpg';" />
                                        <div>
                                            <a href="@Url.Action("Details", new { id = item.IDKhoaHoc })" class="font-weight-bold text-primary text-decoration-none">
                                                @item.TenKhoaHoc
                                            </a>
                                            <div class="small text-muted text-truncate" style="max-width: 320px;">
                                                @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)
                                            </div>
                                            <div class="small text-info mt-1">
                                                <i class="fas fa-layer-group mr-1"></i>@(item.ChuongHocs != null ? item.ChuongHocs.Count : 0) chương • @(item.ChuongHocs != null ? item.ChuongHocs.Sum(c => c.BaiHocs != null ? c.BaiHocs.Count : 0) : 0) bài học
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Cột 3: Danh mục & Giảng viên -->
                                <td>
                                    <div>
                                        <i class="fas fa-folder text-warning mr-1"></i>
                                        <span class="font-weight-bold">@(item.DanhMucKhoaHoc != null ? item.DanhMucKhoaHoc.TenDanhMuc : (item.DanhMuc ?? "Chưa phân loại"))</span>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-chalkboard-teacher text-info mr-1"></i>
                                        @(item.GiangVien != null ? item.GiangVien.TenGV : "Chưa phân công")
                                    </div>
                                </td>

                                <!-- Cột 4: Học phí & Trạng thái -->
                                <td>
                                    <div class="font-weight-bold @(item.HocPhi == 0 || item.HocPhi == null ? "text-success" : "text-danger")">
                                        @(item.HocPhi == 0 || item.HocPhi == null ? "Miễn phí" : string.Format("{0:N0} đ", item.HocPhi))
                                    </div>
                                    <div class="mt-1">
                                        @if (item.TrangThai == "Hiển thị" || string.IsNullOrEmpty(item.TrangThai))
                                        {
                                            <span class="badge badge-status-active">Hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status-locked">Ẩn</span>
                                        }
                                        <span class="small text-muted ml-1">(@(item.DangKyKhoaHocs != null ? item.DangKyKhoaHocs.Count : 0) HV)</span>
                                    </div>
                                </td>

                                <!-- Cột 5: Chức năng -->
                                <td class="text-center text-nowrap">
                                    <a href="@Url.Action("NoiDungKhoaHoc", new { id = item.IDKhoaHoc })" class="btn btn-primary btn-sm shadow-sm" title="Quản lý & duyệt giáo trình bài học">
                                        <i class="fas fa-list-ol"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.IDKhoaHoc })" class="btn btn-info btn-sm shadow-sm ml-1" title="Xem chi tiết & Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @using (Html.BeginForm("Delete", "QuanLyKhoaHoc", new { id = item.IDKhoaHoc }, FormMethod.Post, new { @class = "d-inline ml-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm" 
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa hoặc ẩn khóa học @item.TenKhoaHoc?');"
                                                title="Xóa hoặc Ẩn khóa học">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fa-2x mb-2 text-gray-400 d-block"></i>
                                Không tìm thấy khóa học nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>