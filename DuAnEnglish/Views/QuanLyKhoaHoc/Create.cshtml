@model DuAnEnglish.Models.KhoaHoc

@{
    ViewBag.Title = "Thêm khóa học";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex justify-center items-center bg-gray-100 py-10">
    <div class="bg-white w-full max-w-3xl p-8 rounded-2xl shadow-lg">
        <h2 class="text-3xl font-bold text-center text-red-600 mb-8">Thêm khóa học</h2>

        @using (Html.BeginForm("Create", "QuanLyKhoaHoc", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- ID Khoá học -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">ID khóa học</label>
            @Html.TextBoxFor(m => m.IDKhoaHoc, new
            {
                @class = "mt-1 w-full bg-gray-100 rounded-lg shadow-sm p-2",
                placeholder = "Nhập ID khóa học"
            })
        </div>

        <!-- Tên khóa học -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">Tên khóa học</label>
            @Html.TextBoxFor(m => m.TenKhoaHoc, new
            {
                @class = "mt-1 w-full bg-gray-100 rounded-lg shadow-sm p-2",
                placeholder = "Nhập tên khóa học"
            })
        </div>

        <!-- Danh mục -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">Danh mục</label>
            @{
                var danhMucList = ViewBag.DanhMucList as List<string> ?? new List<string> { "TOEIC", "IELTS" };
            }
            @Html.DropDownListFor(m => m.DanhMuc,
                new SelectList(danhMucList),
                "-- Chọn danh mục --",
                new { @class = "mt-1 w-full bg-gray-100 rounded-lg shadow-sm p-2" })
        </div>


        <!-- Học phí -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">Học phí</label>
            @Html.TextBoxFor(m => m.HocPhi, new
            {
                @class = "mt-1 w-full bg-gray-100 rounded-lg shadow-sm p-2",
                placeholder = "Nhập học phí"
            })
        </div>

        <!-- Mô tả -->
        <div >
            <label class="block text-sm font-semibold text-gray-700">Mô tả</label>
            @Html.TextAreaFor(m => m.MoTa, new
            {
                @class = "mt-1 w-full bg-gray-100 rounded-lg shadow-sm p-2",
                rows = 3,
                placeholder = "Mô tả ngắn gọn về khóa học"
            })
        </div>

        <!-- Hình Ảnh -->
        <div>
            <label class="block text-sm font-semibold text-gray-700">Hình ảnh</label>

            <div class="flex items-center gap-4 mt-1">
                <!-- TextBox hiển thị tên file -->
                @Html.TextBoxFor(m => m.HinhAnhKH, new
                {
                    @class = "w-1/2 bg-gray-100 rounded-lg shadow-sm p-2",
                    @readonly = "readonly",
                    @placeholder = "Tên hình ảnh"
                })

                <!-- Input file ẩn -->
                <input type="file" id="ImageFile" name="ImageFile"
                       accept="image/*"
                       class="hidden" onchange="updateFileName()" />

                <!-- Nút tải lên (rộng hơn) -->
                <button type="button" onclick="document.getElementById('ImageFile').click();"
                        class="w-1/2 bg-gray-300 hover:bg-gray-200 text-black font-medium py-2 px-4 rounded-lg shadow">
                    Tải lên
                </button>
            </div>
        </div>

    </div>

    <div class="mt-8 flex justify-center gap-4">
        <button type="submit"
                class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-6 rounded-lg shadow">
            Thêm
        </button>
    </div>
        }
    </div>
</div>

<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
<script>
    function updateFileName() {
        const input = document.getElementById("ImageFile");
        const fileName = input.files[0]?.name;
        if (fileName) {
            document.querySelector('input[name="HinhAnhKH"]').value = fileName;
        }
    }
</script>
