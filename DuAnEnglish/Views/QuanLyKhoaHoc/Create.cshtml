@model DuAnEnglish.Models.KhoaHoc
@{
    ViewBag.Title = "Thêm Khóa Học Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">THÊM KHÓA HỌC MỚI</h1>
    <a href="@Url.Action("QuanLyKhoaHoc")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
    </a>
</div>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-plus-circle mr-1"></i> Thông Tin Khóa Học Mới</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "QuanLyKhoaHoc", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Mã Khóa Học <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.IDKhoaHoc, new { @class = "form-control", placeholder = "Ví dụ: CSHARP01, MVC2026...", required = "required" })
                            <small class="form-text text-muted">Mã duy nhất, viết hoa, không dấu cách.</small>
                        </div>

                        <div class="form-group col-md-8">
                            <label class="font-weight-bold text-gray-700">Tên Khóa Học <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenKhoaHoc, new { @class = "form-control", placeholder = "Nhập tên khóa học...", required = "required" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Danh Mục Khóa Học</label>
                            @Html.DropDownList("IDDanhMuc", null, "-- Chọn danh mục --", new { @class = "form-control" })
                        </div>

                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Giảng Viên Phụ Trách</label>
                            @Html.DropDownList("IDGiangVien", null, "-- Phân công giảng viên --", new { @class = "form-control" })
                        </div>

                        <div class="form-group col-md-4">
                            <label class="font-weight-bold text-gray-700">Học Phí (VNĐ)</label>
                            @Html.TextBoxFor(m => m.HocPhi, new { @class = "form-control", type = "number", min = "0", step = "1000", placeholder = "0 nếu miễn phí" })
                            <small class="form-text text-muted">Để 0 cho khóa học miễn phí.</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Hình Ảnh Đại Diện Khóa Học</label>
                            <input type="file" name="ImageFile" class="form-control-file border rounded p-1" accept="image/*" />
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Trạng Thái Hiển Thị</label>
                            <select name="TrangThai" class="form-control">
                                <option value="Hiển thị" selected>Hiển thị công khai</option>
                                <option value="Ẩn">Ẩn khóa học</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Mô Tả Ngắn</label>
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3", placeholder = "Tóm tắt ngắn gọn mục tiêu và đối tượng của khóa học..." })
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Nội Dung Giới Thiệu Chi Tiết</label>
                        @Html.TextAreaFor(m => m.NoiDung, new { @class = "form-control", rows = "5", placeholder = "Nội dung đề cương, kiến thức thu được sau khóa học (hỗ trợ mã HTML)..." })
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("QuanLyKhoaHoc")" class="btn btn-secondary mr-2">
                            <i class="fas fa-times mr-1"></i> Hủy Bỏ
                        </a>
                        <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                            <i class="fas fa-save mr-1"></i> Lưu Khóa Học
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
