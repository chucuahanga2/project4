@model DuAnEnglish.Models.KhoaHoc
@{
    ViewBag.Title = "Chi tiết & Chỉnh sửa Khóa học: " + Model.TenKhoaHoc;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string currentImg = !string.IsNullOrEmpty(Model.HinhAnhKH) ? Url.Content("~/Images/" + Model.HinhAnhKH) : Url.Content("~/Images/default_course.png");
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">CHỈNH SỬA KHÓA HỌC: @Model.IDKhoaHoc</h1>
    <a href="@Url.Action("QuanLyKhoaHoc")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
    </a>
</div>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-edit mr-1"></i> Cập Nhật Thông Tin Khóa Học</h6>
                <span class="badge badge-light border">Mã: @Model.IDKhoaHoc</span>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Details", "QuanLyKhoaHoc", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.IDKhoaHoc)

                    <div class="form-row">
                        <div class="col-md-3 text-center mb-3">
                            <label class="font-weight-bold text-gray-700 d-block">Ảnh Đại Diện</label>
                            <img src="@currentImg" class="img-thumbnail shadow-sm mb-2" style="max-height: 140px; object-fit: cover;" onerror="this.src='/Images/TI_CoBan.jpg';" />
                            <input type="file" name="ImageFile" class="form-control-file border rounded p-1 small" accept="image/*" />
                        </div>

                        <div class="col-md-9">
                            <div class="form-group">
                                <label class="font-weight-bold text-gray-700">Tên Khóa Học <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.TenKhoaHoc, new { @class = "form-control font-weight-bold", required = "required" })
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label class="font-weight-bold text-gray-700">Danh Mục</label>
                                    @Html.DropDownList("IDDanhMuc", null, new { @class = "form-control" })
                                </div>

                                <div class="form-group col-md-4">
                                    <label class="font-weight-bold text-gray-700">Giảng Viên</label>
                                    @Html.DropDownList("IDGiangVien", null, new { @class = "form-control" })
                                </div>

                                <div class="form-group col-md-4">
                                    <label class="font-weight-bold text-gray-700">Học Phí (VNĐ)</label>
                                    @Html.TextBoxFor(m => m.HocPhi, new { @class = "form-control", type = "number", min = "0", step = "1000" })
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label class="font-weight-bold text-gray-700">Trạng Thái</label>
                                    <select name="TrangThai" class="form-control">
                                        <option value="Hiển thị" @(Model.TrangThai == "Hiển thị" ? "selected" : "")>Hiển thị công khai</option>
                                        <option value="Ẩn" @(Model.TrangThai == "Ẩn" ? "selected" : "")>Ẩn khóa học</option>
                                    </select>
                                </div>
                                <div class="form-group col-md-6">
                                    <label class="font-weight-bold text-gray-700">Ngày Tạo</label>
                                    <input type="text" class="form-control bg-light" value="@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Mô Tả Ngắn</label>
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">Nội Dung Giới Thiệu Chi Tiết</label>
                        @Html.TextAreaFor(m => m.NoiDung, new { @class = "form-control", rows = "6" })
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Delete", new { id = Model.IDKhoaHoc })" 
                           class="btn btn-danger btn-sm" 
                           onclick="return confirm('Bạn có chắc muốn xóa hoặc ẩn khóa học này?');">
                            <i class="fas fa-trash-alt mr-1"></i> Xóa / Ẩn Khóa Học
                        </a>
                        <div>
                            <a href="@Url.Action("QuanLyKhoaHoc")" class="btn btn-secondary mr-2">
                                <i class="fas fa-times mr-1"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-1"></i> Lưu Cập Nhật
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
