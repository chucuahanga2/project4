@model List<DuAnEnglish.Models.ThanhToan>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Báo cáo thống kê doanh thu";
    int? selectedThang = ViewBag.SelectedThang as int?;
    int? selectedQuy = ViewBag.SelectedQuy as int?;
    int selectedNam = ViewBag.SelectedNam ?? DateTime.Now.Year;
    decimal tongDoanhThu = ViewBag.TongDoanhThuKy ?? 0;
    int tongGiaoDich = ViewBag.TongSoGiaoDich ?? 0;
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800 font-weight-bold">BÁO CÁO THỐNG KÊ DOANH THU</h1>
<p class="mb-4">Theo dõi chi tiết số liệu doanh thu từ học phí khóa học trực tuyến theo tháng, quý và năm.</p>

<!-- Filter Card (SB Admin 2 format) -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-filter mr-1"></i> Bộ Lọc Báo Cáo Doanh Thu
        </h6>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("BaoCaoThongKe", "QLBaoCaoThongKe", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group mb-2 mr-3">
                <label class="mr-2 font-weight-bold">Theo tháng:</label>
                <select name="thang" class="form-control form-control-sm">
                    <option value="">-- Tất cả tháng --</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" @(selectedThang == i ? "selected" : "")>Tháng @i</option>
                    }
                </select>
            </div>

            <div class="form-group mb-2 mr-3">
                <label class="mr-2 font-weight-bold">Theo quý:</label>
                <select name="quy" class="form-control form-control-sm">
                    <option value="">-- Tất cả quý --</option>
                    <option value="1" @(selectedQuy == 1 ? "selected" : "")>Quý 1 (Tháng 1-3)</option>
                    <option value="2" @(selectedQuy == 2 ? "selected" : "")>Quý 2 (Tháng 4-6)</option>
                    <option value="3" @(selectedQuy == 3 ? "selected" : "")>Quý 3 (Tháng 7-9)</option>
                    <option value="4" @(selectedQuy == 4 ? "selected" : "")>Quý 4 (Tháng 10-12)</option>
                </select>
            </div>

            <div class="form-group mb-2 mr-3">
                <label class="mr-2 font-weight-bold">Năm:</label>
                <input type="number" name="nam" min="2020" max="2035" value="@selectedNam" class="form-control form-control-sm" style="width: 100px;" />
            </div>

            <button type="submit" class="btn btn-primary btn-sm mb-2 shadow-sm font-weight-bold mr-2">
                <i class="fas fa-chart-line mr-1"></i> Xem Báo Cáo
            </button>
            <a href="@Url.Action("BaoCaoThongKe")" class="btn btn-secondary btn-sm mb-2 shadow-sm">
                <i class="fas fa-redo mr-1"></i> Mặc định
            </a>
        }
    </div>
</div>

<!-- KPI Cards -->
<div class="row">
    <!-- Doanh thu tổng kỳ -->
    <div class="col-xl-6 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Tổng Doanh Thu Trong Kỳ
                        </div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">
                            @string.Format("{0:N0} đ", tongDoanhThu)
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Số lượng giao dịch thành công -->
    <div class="col-xl-6 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Số Giao Dịch Thành Công
                        </div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">
                            @tongGiaoDich giao dịch
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-receipt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DataTales Card (SB Admin 2 format, 5 columns) -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-list-alt mr-1"></i> Chi Tiết Doanh Thu Từng Đơn Hàng
        </h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 100px;" class="text-center">Mã HĐ</th>
                        <th>Học viên</th>
                        <th>Khóa học</th>
                        <th style="width: 180px;">Thời gian thanh toán</th>
                        <th style="width: 170px;" class="text-right">Số tiền thực thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Cột 1: Mã HĐ -->
                                <td class="text-center font-weight-bold text-primary">
                                    #@item.IDThanhToan
                                </td>

                                <!-- Cột 2: Học viên -->
                                <td>
                                    <div class="font-weight-bold text-gray-800">
                                        <i class="fas fa-user-circle mr-1 text-muted"></i> @item.TenDangNhap
                                    </div>
                                    <div class="small text-muted">
                                        Phương thức: @(string.IsNullOrEmpty(item.PhuongThucTT) ? "VNPay Online" : item.PhuongThucTT)
                                    </div>
                                </td>

                                <!-- Cột 3: Khóa học -->
                                <td>
                                    <div class="font-weight-bold text-primary">
                                        @(item.KhoaHoc != null ? item.KhoaHoc.TenKhoaHoc : item.IDKhoaHoc)
                                    </div>
                                    <div class="small text-muted">
                                        Mã KH: @item.IDKhoaHoc
                                    </div>
                                </td>

                                <!-- Cột 4: Thời gian thanh toán -->
                                <td>
                                    <i class="far fa-clock mr-1 text-muted"></i>
                                    @(item.NgayThanhToan.HasValue ? item.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                </td>

                                <!-- Cột 5: Số tiền -->
                                <td class="text-right font-weight-bold text-success">
                                    @string.Format("{0:N0} đ", item.SoTien ?? 0)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-chart-pie fa-2x mb-2 text-gray-400 d-block"></i>
                                Không có giao dịch thanh toán nào phù hợp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model != null && Model.Any())
                {
                    <tfoot>
                        <tr class="font-weight-bold bg-light">
                            <td colspan="4" class="text-right text-uppercase text-primary">Tổng cộng:</td>
                            <td class="text-right text-danger h5 mb-0 font-weight-bold">@string.Format("{0:N0} đ", tongDoanhThu)</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
