@model List<DuAnEnglish.Models.ThanhToan>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "BaoCaoThongKe";
}

<div class="min-h-screen flex flex-col items-center justify-center bg-gray-100 p-4">
    @using (Html.BeginForm("BaoCaoThongKe", "QLBaoCaoThongKe", FormMethod.Get))
    {
        <div class="bg-white p-6 rounded-xl shadow-md flex flex-wrap items-center justify-center gap-4 mb-8 w-full max-w-4xl">
            <div class="flex items-center gap-2">
                <label class="font-medium">Chọn tháng:</label>
                <select name="thang" class="border border-gray-300 rounded px-3 py-1">
                    <option value="">-- Tháng --</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <label class="font-medium">Chọn quý:</label>
                <select name="quy" class="border border-gray-300 rounded px-3 py-1">
                    <option value="">-- Quý --</option>
                    <option value="1">Quý 1</option>
                    <option value="2">Quý 2</option>
                    <option value="3">Quý 3</option>
                    <option value="4">Quý 4</option>
                </select>
            </div>

            <div class="flex items-center gap-2">
                <label class="font-medium">Năm:</label>
                <input type="number" name="nam" min="2000" max="2100" value="@DateTime.Now.Year"
                       class="border border-gray-300 rounded px-3 py-1 w-28" />
            </div>

            <button type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
                Thống kê
            </button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        decimal tong = 0;
        <div class="overflow-x-auto w-full max-w-5xl bg-white shadow rounded-xl">
            <table class="min-w-full table-auto text-sm text-center border border-gray-200">
                <thead class="bg-gray-100 text-gray-700 font-semibold">
                    <tr>
                        <th class="px-4 py-2 border-b">Mã thanh toán</th>
                        <th class="px-4 py-2 border-b">Số tiền</th>
                        <th class="px-4 py-2 border-b">Ngày thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        tong += item.SoTien ?? 0;
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-2 border-b">@item.IDThanhToan</td>
                            <td class="px-4 py-2 border-b text-right">@String.Format("{0:N0} đ", item.SoTien)</td>
                            <td class="px-4 py-2 border-b">
                                @(item.NgayThanhToan != null ? item.NgayThanhToan.Value.ToString("dd/MM/yyyy") : "")
                            </td>
                        </tr>
                    }
                    <tr class="font-bold bg-gray-100">
                        <td colspan="2" class="px-4 py-2 text-right">Tổng doanh thu:</td>
                        <td class="px-4 py-2 text-right text-green-600">@String.Format("{0:N0} đ", tong)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-gray-500 text-center mt-4">Không có dữ liệu thống kê phù hợp</p>
    }
</div>
