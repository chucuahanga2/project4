@{
    if (Session["Role"] != null)
    {
        var role = Session["Role"].ToString().ToLower();
        if (role == "admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        }
        else if (role == "giangvien")
        {
            Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
        }
    }
}

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white shadow-lg rounded-xl w-full max-w-md p-8">
        <div class="mt-4">
            <a href="@Url.Action("QuanLyPhongHoc", "QuanLyPhongHoc")" class="inline-block py-2 px-4 mb-8 text-sm font-medium rounded-lg bg-red-600 text-white hover:bg-red-500">
                <i class="fas fa-arrow-left"></i> Trở lại
            </a>
        </div>
        <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Thêm Phòng Học</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="IDPhongHoc" class="block text-sm font-medium text-gray-700 mb-1">Mã Phòng Học</label>
                <input type="text" id="IDPhongHoc" name="IDPhongHoc" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-4">
                <label for="TenPhong" class="block text-sm font-medium text-gray-700 mb-1">Tên Phòng Học</label>
                <input type="text" id="TenPhong" name="TenPhong" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div class="mb-6">
                <label for="SucChua" class="block text-sm font-medium text-gray-700 mb-1">Sức Chứa</label>
                <div class="flex items-center space-x-2">
                    <button type="button" onclick="changeCapacity(-1)" class="px-3 py-1 bg-gray-300 rounded hover:bg-gray-400">-</button>
                    <input type="number" id="SucChua" name="SucChua" value="0" min="0" max="20" class="w-full text-center px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                    <button type="button" onclick="changeCapacity(1)" class="px-3 py-1 bg-gray-300 rounded hover:bg-gray-400">+</button>
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200">
                Thêm Phòng Học
            </button>
        }
    </div>
</div>

@section Scripts {
    <script>
        function changeCapacity(value) {
            var capacity = parseInt(document.getElementById('SucChua').value) || 0;
            var newCapacity = capacity + value;
            if (newCapacity >= 0 && newCapacity <= 20) {
                document.getElementById('SucChua').value = newCapacity;
            }
        }
    </script>
}

<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
