@model List<DuAnEnglish.Models.ThanhToan>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lịch Sử Giao Dịch & Hóa Đơn - TikiCourse";
}

<!-- Breadcrumbs (Tiki Style) -->
<nav class="flex items-center gap-2 text-xs text-[#808089] mb-4">
    <a href="@Url.Action("Index", "Home")" class="hover:text-[#1a94ff] transition">Trang chủ</a>
    <span>&rsaquo;</span>
    <span class="text-[#27272a] font-medium">Lịch sử giao dịch &amp; hóa đơn</span>
</nav>

<!-- Page Header (Tiki Style) -->
<div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm p-5 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-lg font-black text-[#27272a] uppercase tracking-wide flex items-center gap-2">
            <i class="fas fa-file-invoice-dollar text-[#1a94ff]"></i> LỊCH SỬ ĐƠN HÀNG &amp; THANH TOÁN
        </h1>
        <p class="text-xs text-[#808089] mt-0.5">Theo dõi chi tiết các giao dịch mua khóa học trực tuyến qua cổng VNPay.</p>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="mb-5 p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-xs flex items-center gap-2">
        <i class="fas fa-info-circle text-[#1a94ff]"></i>
        <span>@TempData["ThongBao"]</span>
    </div>
}

<div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm overflow-hidden">
    @if (Model != null && Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-[#fafafa] text-[#808089] uppercase font-bold border-b border-[#ebebf0]">
                        <th class="py-3 px-4">Mã đơn</th>
                        <th class="py-3 px-4">Khóa học đăng ký</th>
                        <th class="py-3 px-4">Số tiền</th>
                        <th class="py-3 px-4">Ngày tạo</th>
                        <th class="py-3 px-4 text-center">Trạng thái</th>
                        <th class="py-3 px-4 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#ebebf0]">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/30 transition">
                            <td class="py-3 px-4 font-bold text-[#27272a]">
                                #@item.IDThanhToan
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-bold text-[#27272a]">
                                    @(item.KhoaHoc != null ? item.KhoaHoc.TenKhoaHoc : item.IDKhoaHoc)
                                </div>
                                <div class="text-[11px] text-[#808089]">Mã KH: @item.IDKhoaHoc</div>
                            </td>
                            <td class="py-3 px-4 font-extrabold text-[#ff424e]">
                                @(item.SoTien.HasValue ? item.SoTien.Value.ToString("N0") + " ₫" : "0 ₫")
                            </td>
                            <td class="py-3 px-4 text-[#808089]">
                                @(item.NgayThanhToan.HasValue ? item.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (item.TrangThai == "Đã thanh toán")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-[#00ab56] border border-emerald-200">
                                        <i class="fas fa-check-circle mr-1"></i> Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-600 border border-amber-200">
                                        <i class="fas fa-clock mr-1"></i> Chờ thanh toán
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (item.TrangThai == "Đã thanh toán")
                                {
                                    <a href="@Url.Action("VaoHoc", "HocTap", new { id = item.IDKhoaHoc })" 
                                       class="px-3 py-1.5 rounded-lg bg-[#e5f2ff] hover:bg-[#1a94ff] text-[#0b74e5] hover:text-white font-bold transition inline-block">
                                        <i class="fas fa-play mr-1"></i> Vào học
                                    </a>
                                }
                                else
                                {
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a href="@Url.Action("HoaDon", "ThanhToan", new { id = item.IDThanhToan })" 
                                           class="px-3 py-1.5 rounded-lg bg-[#ff424e] hover:bg-red-600 text-white font-bold transition shadow-sm inline-block">
                                            Thanh toán
                                        </a>
                                        <form method="post" action="@Url.Action("XoaHoaDon", "ThanhToan", new { id = item.IDThanhToan })" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn hủy hóa đơn này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition" title="Hủy hóa đơn">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-12 text-center text-[#808089]">
            <i class="fas fa-receipt text-4xl text-gray-300 mb-3"></i>
            <p class="text-xs">Chưa có giao dịch hóa đơn nào.</p>
        </div>
    }
</div>
