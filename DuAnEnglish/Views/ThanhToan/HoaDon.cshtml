@model DuAnEnglish.Models.ThanhToan

@{
    Layout = "~/Views/Shared/_LayoutHocVien.cshtml";
    ViewBag.Title = "Hóa đơn thanh toán";
    var ngayThanhToan = DateTime.Now;
}

<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="w-full max-w-2xl p-8 bg-white rounded-lg shadow-lg">
        <h2 class="mb-8 text-center text-3xl font-bold text-red-600">Thông tin hóa đơn</h2>

        @using (Html.BeginForm("ProcessPayment", "ThanhToan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- Các hidden field cần thiết -->
            @Html.HiddenFor(m => m.IDThanhToan)
            <input type="hidden" name="ngayThanhToan" value="@ngayThanhToan.ToString("yyyy-MM-dd HH:mm:ss")" />

            <div class="table-responsive">
                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Mã Hóa Đơn:</strong></label>
                    <div class="pl-2 w-2/3">@Model.IDThanhToan</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Mã Lớp Học:</strong></label>
                    <div class="pl-2 w-2/3">@Model.IDLopHoc</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Tên Lớp Học:</strong></label>
                    <div class="pl-2 w-2/3">@ViewBag.TenLop</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Mã Khóa Học:</strong></label>
                    <div class="pl-2 w-2/3">@Model.IDKhoaHoc</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Tên Khóa Học:</strong></label>
                    <div class="pl-2 w-2/3">@ViewBag.TenKhoaHoc</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Tên Học Viên:</strong></label>
                    <div class="pl-2 w-2/3">@ViewBag.TenHocVien</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Số tiền:</strong></label>
                    <div class="pl-2 w-2/3">@(Model.SoTien.HasValue ? Model.SoTien.Value.ToString("N0") + " VNĐ" : "0 VNĐ")</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Ngày thanh toán:</strong></label>
                    <div class="pl-2 w-2/3">@ngayThanhToan.ToString("dd/MM/yyyy HH:mm:ss")</div>
                </div>

                <div class="form-group mb-6 flex justify-between">
                    <label class="block font-medium w-1/3"><strong>Phương thức thanh toán:</strong></label>
                    <div class="pl-2 w-2/3">Thanh toán Vnpay</div>
                </div>
            </div>

            <div class="flex justify-center mt-6">
                <a href="@Url.Action("ThanhToanVNPay", "ThanhToan", new { id = Model.IDThanhToan })"
                   target="_blank"
                   class="inline-block py-3 px-6 text-lg font-semibold rounded-lg bg-gradient-to-r from-green-400 via-green-500 to-green-600 bg-[length:200%_auto] bg-left hover:bg-right transition-all duration-1000 ease-out text-white shadow-md">
                    Xác nhận thanh toán
                </a>
            </div>
        }
    </div>
</div>
