@model DuAnEnglish.Models.ThanhToan
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thanh Toán Đơn Hàng #" + Model.IDThanhToan + " - TikiCourse";
}

<!-- Breadcrumbs (Tiki Style) -->
<nav class="flex items-center gap-2 text-xs text-[#808089] mb-4">
    <a href="@Url.Action("Index", "Home")" class="hover:text-[#1a94ff] transition">Trang chủ</a>
    <span>&rsaquo;</span>
    <a href="@Url.Action("KhoaHoc", "KhoaHoc")" class="hover:text-[#1a94ff] transition">Khóa học</a>
    <span>&rsaquo;</span>
    <span class="text-[#27272a] font-medium">Thanh toán đơn hàng #@Model.IDThanhToan</span>
</nav>

<div class="max-w-2xl mx-auto py-4">
    <!-- Invoice Card (Tiki Checkout Style) -->
    <div class="bg-white rounded-xl border border-[#ebebf0] shadow-sm overflow-hidden">
        <!-- Header -->
        <div class="bg-[#1a94ff] p-6 text-white">
            <div class="flex items-center justify-between mb-3">
                <span class="px-2.5 py-0.5 rounded-full bg-white/20 text-xs font-bold uppercase tracking-wider">
                    Hóa Đơn Mua Khóa Học
                </span>
                <span class="font-mono text-xs opacity-90">Mã giao dịch: #@Model.IDThanhToan</span>
            </div>
            <h2 class="text-xl md:text-2xl font-black">Xác Nhận &amp; Thanh Toán Khóa Học</h2>
            <p class="text-blue-100 text-xs mt-1">Cổng thanh toán điện tử VNPay bảo mật tiêu chuẩn quốc tế.</p>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-5">
            <div class="p-4 bg-[#fafafa] rounded-xl border border-[#ebebf0] space-y-3">
                <div class="flex justify-between items-center text-xs">
                    <span class="text-[#808089]">Khóa học đăng ký:</span>
                    <span class="font-bold text-[#27272a] text-right">@(Model.KhoaHoc != null ? Model.KhoaHoc.TenKhoaHoc : (ViewBag.TenKhoaHoc ?? Model.IDKhoaHoc))</span>
                </div>
                <div class="flex justify-between items-center text-xs">
                    <span class="text-[#808089]">Mã khóa học:</span>
                    <span class="font-mono text-[#27272a]">@Model.IDKhoaHoc</span>
                </div>
                <div class="flex justify-between items-center text-xs">
                    <span class="text-[#808089]">Học viên đăng ký:</span>
                    <span class="font-bold text-[#27272a]">@(ViewBag.TenHocVien ?? Model.TenDangNhap)</span>
                </div>
                <div class="flex justify-between items-center text-xs">
                    <span class="text-[#808089]">Phương thức thanh toán:</span>
                    <span class="font-semibold text-[#0b74e5] flex items-center gap-1.5">
                        <i class="fas fa-qrcode"></i> VNPay QR &bull; Thẻ ATM &bull; Visa/Mastercard
                    </span>
                </div>
                <div class="pt-3 border-t border-[#ebebf0] flex justify-between items-center">
                    <span class="font-bold text-[#27272a] text-sm">Tổng số tiền thanh toán:</span>
                    <span class="font-black text-2xl text-[#ff424e]">
                        @(Model.SoTien.HasValue ? string.Format("{0:N0} ₫", Model.SoTien.Value) : "0 ₫")
                    </span>
                </div>
            </div>

            <!-- Notes -->
            @if (Model.TrangThai == "Thanh toán thất bại")
            {
                <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs leading-relaxed flex items-start gap-2.5">
                    <i class="fas fa-exclamation-triangle text-[#ff424e] text-sm mt-0.5"></i>
                    <div>
                        <strong>Giao dịch trước đó không thành công:</strong> Lần thanh toán trước của bạn đã bị hủy hoặc gặp sự cố. Bạn hoàn toàn có thể bấm <strong>"Thanh toán lại qua VNPay"</strong> bên dưới để hoàn tất kích hoạt khóa học mà không cần đăng ký lại từ đầu!
                    </div>
                </div>
            }
            else
            {
                <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs leading-relaxed flex items-start gap-2.5">
                    <i class="fas fa-shield-alt text-amber-500 text-sm mt-0.5"></i>
                    <div>
                        Sau khi bấm nút <strong>"Tiến Hành Thanh Toán VNPay"</strong>, bạn sẽ được chuyển hướng sang cổng thanh toán bảo mật VNPay Sandbox để hoàn tất giao dịch. Khóa học sẽ tự động được kích hoạt ngay lập tức khi thanh toán thành công!
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="pt-2 flex flex-col sm:flex-row gap-3">
                <a href="@Url.Action("ChiTietKhoaHoc", "KhoaHoc", new { id = Model.IDKhoaHoc })" 
                   class="w-full sm:w-1/3 py-2.5 rounded-lg border border-[#ebebf0] hover:bg-gray-50 text-center font-bold text-xs text-[#808089] transition">
                    Hủy giao dịch
                </a>
                <form method="post" action="@Url.Action("ThanhToanVNPay", "ThanhToan", new { id = Model.IDThanhToan })" class="w-full sm:w-2/3">
                    @Html.AntiForgeryToken()
                    <button type="submit" 
                            class="w-full py-2.5 rounded-lg bg-[#ff424e] hover:bg-red-600 text-center font-bold text-xs text-white shadow transition flex items-center justify-center gap-2">
                        <i class="fas fa-lock"></i> @(Model.TrangThai == "Thanh toán thất bại" ? "Thanh toán lại qua VNPay" : "Tiến Hành Thanh Toán VNPay")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
