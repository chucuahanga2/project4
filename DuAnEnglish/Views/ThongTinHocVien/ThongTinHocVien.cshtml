@model DuAnEnglish.Models.HocVien
@{
    Layout = "~/Views/Shared/_LayoutHocVien.cshtml";
    ViewBag.Title = "Thông Tin Học Viên";
}
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
    <form method="post" class="bg-white shadow-xl rounded-2xl p-10 w-full max-w-4xl">
        <h2 class="text-3xl font-bold text-red-600 mb-8 text-center">Thông Tin Học Viên</h2>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">ID Học Viên</label>
            <p class="text-red-600 font-semibold">@Model.IDHocVien</p>
        </div>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">Họ và tên</label>
            <input type="text" name="TenHV" value="@Model.TenHV"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-500" />
        </div>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">Ngày sinh</label>
            <input type="date" name="NgaySinh"
                   value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("yyyy-MM-dd") : "")"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-500" />
        </div>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">Giới tính</label>
            <div class="flex gap-6 mt-2 text-black">
                <label><input type="radio" name="GioiTinh" value="Nam" @(Model.GioiTinh == "Nam" ? "checked" : "") class="mr-1" /> Nam</label>
                <label><input type="radio" name="GioiTinh" value="Nữ" @(Model.GioiTinh == "Nữ" ? "checked" : "") class="mr-1" /> Nữ</label>
                <label><input type="radio" name="GioiTinh" value="Khác" @(Model.GioiTinh == "Khác" ? "checked" : "") class="mr-1" /> Khác</label>
            </div>
        </div>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">Địa chỉ</label>
            <input type="text" name="DiaChi" value="@Model.DiaChi"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-500" />
        </div>

        <div class="mb-5">
            <label class="block text-black font-medium mb-1">Email</label>
            <input type="email" name="TaiKhoan.Email" value="@Model.TaiKhoan.Email"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-500" />
        </div>

        <div class="mb-8">
            <label class="block text-black font-medium mb-1">Số điện thoại</label>
            <input type="text" name="TaiKhoan.SDT" value="@Model.TaiKhoan.SDT"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-500" />
        </div>

        <div class="text-center">
            <button type="submit"
                    class="w-full py-3 px-6 text-lg font-semibold rounded-lg bg-gradient-to-r from-red-600 via-yellow-400 to-red-600
               bg-[length:200%_auto] bg-left hover:bg-right transition-all duration-1000 ease-out
               text-white shadow-md">
                Cập nhật thông tin
            </button>
        </div>
    </form>
</div>

<script src="~/Scripts/JSThongBao.js"></script>

@if (ViewBag.ThongBao != null)
{
    <script>
        showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}