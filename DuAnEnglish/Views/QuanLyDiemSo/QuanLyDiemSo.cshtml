@model List<DuAnEnglish.ViewModels.DiemViewModel>

@using System.Linq

@{
    ViewBag.Title = "Quản Lý Điểm IELTS";
    Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
}
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

<div class="bg-white max-w-[90%] mx-auto px-4 h-auto
         flex flex-col items-center justify-center
         min-h-[calc(100vh-100px)]">
    <h2 class="text-2xl font-bold mb-4 text-red-600">Quản Lý Điểm</h2>

    <!-- Sửa phần này -->
    <form method="get" action="@Url.Action("QuanLyDiemSo", "QuanLyDiemSo")" class="mb-6 flex gap-4 items-center w-full">
        <p class="self-center">Lớp :</p>
        <input type="text" name="idLop" placeholder="LH005" value="@(ViewBag.TuKhoa ?? "")"
               class="w-[150px] px-4 py-2 border focus:outline-none focus:ring-2 focus:ring-blue-500" />
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white hover:bg-blue-700">
            Tìm kiếm
        </button>
    </form>


    <table class="w-full border-collapse">
        <thead>
            <tr>
                <!-- Thêm border-b cho viền dưới header -->
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">ID Học Viên</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Nghe</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Nói</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Đọc</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Viết</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Tổng Điểm</th>
                <th class="px-4 py-2 border-b-2 border-gray-300 text-left">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <!-- colspan điều chỉnh theo số cột -->
                    <td colspan="7" class="text-center px-4 py-2 border-b border-gray-200">
                        Không có dữ liệu
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <!-- Thêm border-b cho viền dưới mỗi dòng -->
                        <td class="px-4 py-2 border-b border-gray-200">@item.IDHocVien</td>
                        <td class="px-4 py-2 border-b border-gray-200">@item.DiemNghe</td>
                        <td class="px-4 py-2 border-b border-gray-200">@item.DiemNoi</td>
                        <td class="px-4 py-2 border-b border-gray-200">@item.DiemDoc</td>
                        <td class="px-4 py-2 border-b border-gray-200">@item.DiemViet</td>
                        <td class="px-4 py-2 border-b border-gray-200">@item.TongDiem</td>
                        <td class="px-4 py-2 border-b border-gray-200">
                            @if (item.DanhMuc == "ielts")
                            {
                                <a href="@Url.Action("NhapDiemIeltsView", "QuanLyDiemSo", new { idHocVien = item.IDHocVien })"
                                   class="w-[120px] bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors flex items-center gap-2">
                                    Nhập điểm
                                </a>
                            }
                            else if (item.DanhMuc == "toeic")
                            {
                                <a href="@Url.Action("NhapDiemToeicView", "QuanLyDiemSo", new { idHocVien = item.IDHocVien })"
                                   class="w-[120px] bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors flex items-center gap-2">
                                    Nhập điểm
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<script>
    $(function () {
        $("input[name='idLop']").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetLopHocAutocomplete", "QuanLyDiemSo")',
                    dataType: "json",
                    data: {
                        term: request.term
                    },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 1 // Bắt đầu gợi ý sau khi nhập 1 ký tự
        });
    });
</script>
