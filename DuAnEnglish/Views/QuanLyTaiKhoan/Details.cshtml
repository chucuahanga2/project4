@model DuAnEnglish.Models.TaiKhoan
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Chi tiết & Chỉnh sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold">CHI TIẾT TÀI KHOẢN: @Model.TenDangNhap</h1>
            <a href="@Url.Action("QuanLyTaiKhoan")" class="btn btn-secondary btn-sm shadow-sm">
                <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại danh sách
            </a>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- Card Form (SB Admin 2 format) -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-user-edit mr-1"></i> Thông Tin Chi Tiết
                </h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Details", "QuanLyTaiKhoan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.TenDangNhap)

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Tên đăng nhập</label>
                            <input type="text" value="@Model.TenDangNhap" class="form-control bg-light font-weight-bold" readonly />
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Loại tài khoản / Quyền</label>
                            @Html.DropDownListFor(m => m.LoaiTK, ViewBag.LoaiTKList as SelectList, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Địa chỉ Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email" })
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SDT, new { @class = "form-control", @type = "tel" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Trạng thái hoạt động</label>
                            @Html.DropDownListFor(m => m.TrangThai, 
                                new SelectList(new[] { "Hoạt động", "Khóa" }, Model.TrangThai), 
                                new { @class = "form-control" })
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between">
                        <div>
                            @if (Model.TenDangNhap.ToLower() != "admin")
                            {
                                <button type="submit" form="formResetMatKhau"
                                   class="btn btn-warning shadow-sm font-weight-bold"
                                   onclick="return confirm('Bạn có chắc muốn đặt lại mật khẩu về 123456 cho @Model.TenDangNhap?');">
                                    <i class="fas fa-key mr-1"></i> Đặt lại mật khẩu (123456)
                                </button>
                            }
                        </div>
                        <div>
                            <a href="@Url.Action("QuanLyTaiKhoan")" class="btn btn-secondary px-4 mr-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                                <i class="fas fa-save mr-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </div>
                }
                @if (Model.TenDangNhap.ToLower() != "admin")
                {
                    using (Html.BeginForm("ResetMatKhau", "QuanLyTaiKhoan", new { id = Model.TenDangNhap }, FormMethod.Post, new { id = "formResetMatKhau", style = "display:none;" }))
                    {
                        @Html.AntiForgeryToken()
                    }
                }
            </div>
        </div>
    </div>
</div>