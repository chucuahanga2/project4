@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Thêm tài khoản mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold">THÊM TÀI KHOẢN MỚI</h1>
            <a href="@Url.Action("QuanLyTaiKhoan")" class="btn btn-secondary btn-sm shadow-sm">
                <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại danh sách
            </a>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ThongBao
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- Card Form (SB Admin 2 format) -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-user-plus mr-1"></i> Thông Tin Tài Khoản
                </h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "QuanLyTaiKhoan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" name="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập (viết liền không dấu)" required />
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input type="password" name="MatKhau" class="form-control" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Loại tài khoản / Vai trò <span class="text-danger">*</span></label>
                            @Html.DropDownList("LoaiTK", ViewBag.LoaiTKList as SelectList, "-- Chọn loại tài khoản --", new { @class = "form-control", required = "required" })
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Họ và tên đầy đủ</label>
                            <input type="text" name="HoTen" class="form-control" placeholder="Nhập họ và tên học viên / giảng viên" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Địa chỉ Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="example@email.com" />
                        </div>

                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-700">Số điện thoại</label>
                            <input type="tel" name="SDT" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="text-right">
                        <a href="@Url.Action("QuanLyTaiKhoan")" class="btn btn-secondary px-4 mr-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                            <i class="fas fa-save mr-1"></i> Lưu Tài Khoản
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
