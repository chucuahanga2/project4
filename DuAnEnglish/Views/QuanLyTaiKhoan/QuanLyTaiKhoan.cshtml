@model List<DuAnEnglish.Models.TaiKhoan>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Tài khoản";
    string currentLoai = ViewBag.CurrentLoaiTK as string ?? "all";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800 font-weight-bold">QUẢN LÝ TÀI KHOẢN HỆ THỐNG</h1>
<p class="mb-4">Kiểm soát tất cả tài khoản người dùng, phân quyền truy cập, khóa/mở tài khoản và đặt lại mật khẩu bảo mật.</p>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @ViewBag.ThongBao
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- DataTales Card (SB Admin 2 format) -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-users-cog mr-1"></i> Danh Sách Tài Khoản (@(Model != null ? Model.Count : 0))
        </h6>
        <div class="mt-2 mt-md-0">
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm font-weight-bold">
                <i class="fas fa-user-plus fa-sm mr-1"></i> Thêm Tài Khoản Mới
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Search and Filter Toolbar -->
        <form method="get" action="@Url.Action("QuanLyTaiKhoan")" class="mb-3">
            <div class="form-row align-items-center">
                <div class="col-md-5 my-1">
                    <div class="input-group">
                        <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm theo tên đăng nhập, email, SĐT...">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 my-1">
                    <div class="btn-group btn-group-toggle w-100" data-toggle="buttons">
                        <a href="@Url.Action("QuanLyTaiKhoan", new { loaitaikhoan = "all", search = currentSearch })" 
                           class="btn @(currentLoai == "all" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Tất cả</a>
                        <a href="@Url.Action("QuanLyTaiKhoan", new { loaitaikhoan = "admin", search = currentSearch })" 
                           class="btn @(currentLoai == "admin" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Admin</a>
                        <a href="@Url.Action("QuanLyTaiKhoan", new { loaitaikhoan = "giangvien", search = currentSearch })" 
                           class="btn @(currentLoai == "giangvien" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Giảng viên</a>
                        <a href="@Url.Action("QuanLyTaiKhoan", new { loaitaikhoan = "hocvien", search = currentSearch })" 
                           class="btn @(currentLoai == "hocvien" ? "btn-primary active font-weight-bold" : "btn-outline-secondary") btn-sm">Học viên</a>
                    </div>
                </div>
                <div class="col-md-3 my-1 text-right">
                    <a href="@Url.Action("QuanLyTaiKhoan")" class="btn btn-secondary btn-sm">
                        <i class="fas fa-sync-alt mr-1"></i> Làm mới
                    </a>
                </div>
            </div>
        </form>

        <!-- 5-Column Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 70px;" class="text-center">STT</th>
                        <th>Tên đăng nhập & Vai trò</th>
                        <th>Thông tin liên hệ</th>
                        <th style="width: 150px;" class="text-center">Trạng thái</th>
                        <th style="width: 200px;" class="text-center">Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Cột 1: STT -->
                                <td class="text-center font-weight-bold text-muted">
                                    @stt
                                </td>

                                <!-- Cột 2: Tên đăng nhập & Vai trò -->
                                <td>
                                    <div class="font-weight-bold text-primary">
                                        <i class="fas fa-user-circle mr-1"></i> @item.TenDangNhap
                                    </div>
                                    <div class="mt-1">
                                        @if (item.LoaiTK == "admin")
                                        {
                                            <span class="badge badge-danger"><i class="fas fa-shield-alt mr-1"></i> Quản trị viên</span>
                                        }
                                        else if (item.LoaiTK == "giangvien")
                                        {
                                            <span class="badge badge-info"><i class="fas fa-chalkboard-teacher mr-1"></i> Giảng viên</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success"><i class="fas fa-user-graduate mr-1"></i> Học viên</span>
                                        }
                                    </div>
                                </td>

                                <!-- Cột 3: Thông tin liên hệ -->
                                <td>
                                    <div>
                                        <i class="fas fa-envelope text-muted mr-1"></i>
                                        @(string.IsNullOrEmpty(item.Email) ? "Chưa cập nhật email" : item.Email)
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-phone-alt text-muted mr-1"></i>
                                        @(string.IsNullOrEmpty(item.SDT) ? "Chưa cập nhật SĐT" : item.SDT)
                                    </div>
                                </td>

                                <!-- Cột 4: Trạng thái -->
                                <td class="text-center">
                                    @if (item.TrangThai == "Hoạt động" || string.IsNullOrEmpty(item.TrangThai))
                                    {
                                        <span class="badge badge-status-active">
                                            <i class="fas fa-check-circle mr-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-locked">
                                            <i class="fas fa-lock mr-1"></i> Đã Khóa
                                        </span>
                                    }
                                </td>

                                <!-- Cột 5: Chức năng -->
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.TenDangNhap })" class="btn btn-info btn-sm shadow-sm" title="Xem chi tiết & Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    @if (item.TenDangNhap.ToLower() != "admin")
                                    {
                                        if (item.TrangThai == "Khóa")
                                        {
                                            <a href="@Url.Action("KhoaMoTaiKhoan", new { id = item.TenDangNhap })" 
                                               class="btn btn-success btn-sm shadow-sm ml-1" 
                                               onclick="return confirm('Mở khóa cho tài khoản @item.TenDangNhap?');"
                                               title="Mở khóa tài khoản">
                                                <i class="fas fa-unlock"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("KhoaMoTaiKhoan", new { id = item.TenDangNhap })" 
                                               class="btn btn-warning btn-sm shadow-sm ml-1" 
                                               onclick="return confirm('Khóa tài khoản @item.TenDangNhap?');"
                                               title="Khóa tài khoản">
                                                <i class="fas fa-lock"></i>
                                            </a>
                                        }

                                        <a href="@Url.Action("ResetMatKhau", new { id = item.TenDangNhap })" 
                                           class="btn btn-secondary btn-sm shadow-sm ml-1" 
                                           onclick="return confirm('Đặt lại mật khẩu cho tài khoản @item.TenDangNhap về mặc định (123456)?');"
                                           title="Reset Mật khẩu">
                                            <i class="fas fa-key"></i>
                                        </a>

                                        <a href="@Url.Action("Delete", new { id = item.TenDangNhap })" 
                                           class="btn btn-danger btn-sm shadow-sm ml-1" 
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản @item.TenDangNhap?');"
                                           title="Xóa tài khoản">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary p-1 ml-1" title="Tài khoản hệ thống mặc định">Cố định</span>
                                    }
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-user-slash fa-2x mb-2 text-gray-400 d-block"></i>
                                Không tìm thấy tài khoản nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
